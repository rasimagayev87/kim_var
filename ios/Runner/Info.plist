	<!-- Branch (deferred deep linking). Same key as
	     android/app/src/main/AndroidManifest.xml's io.branch.sdk.BranchKey
	     entry — see the comment there. -->
	<key>branch_key</key>
	<string>key_live_gvCTsTZgmBWo3ILjha8wuacaqFfXTcrJ</string>
	<!-- google_sign_in's iOS redirect URL scheme — REVERSED_CLIENT_ID
	     from GoogleService-Info.plist, already provisioned by Firebase
	     when the project was created (no new Google Cloud Console setup
	     needed). Must match that file's value exactly if it's ever
	     regenerated. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.googleusercontent.apps.148607007767-dkrl4dagoo9isvpgtjg3rmguhd715nqa</string>
			</array>
		</dict>
		<!-- Custom scheme, used two ways: (1) Firebase Email Link
		     sign-in fallback — see deep_link_handler.dart and
		     peakpin-landing's /auth-email-link page; (2) the "PeakPin-də
		     aç" button on /u/{username}'s web fallback page
		     (peakpin://u/{username}), since re-tapping the same https
		     Universal Link from inside a mobile browser doesn't reliably
		     reopen the app on either platform. Doesn't need Associated
		     Domains / apple-app-site-association, unlike the https
		     Universal Link these ride alongside. -->
		<dict>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>peakpin</string>
			</array>
		</dict>
	</array>
	<!-- google_sign_in_ios does NOT read CLIENT_ID from
	     GoogleService-Info.plist automatically — without this key it
	     crashes at sign-in time with "No active configuration. Make
	     sure GIDClientID is set in Info.plist." Same CLIENT_ID (not
	     REVERSED) as GoogleService-Info.plist. -->
	<key>GIDClientID</key>
	<string>148607007767-dkrl4dagoo9isvpgtjg3rmguhd715nqa.apps.googleusercontent.com</string>
