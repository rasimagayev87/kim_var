rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Whether [viewerId] holds an ACCEPTED follow edge pointing AT
    // [ownerId] — single direction, not either-way: "Hesab gizliliyi"
    // gates a `private` account's stories (and, client-side, its media
    // grid — see `_MediaVisibilityGate`) on a real request/approve
    // relationship, so only the viewer's OWN follow of the owner
    // counts, not the reverse. A doc with no `status` field (every
    // edge created before "Hesab gizliliyi") is treated as accepted,
    // matching `FirebaseFollowRepository`'s own read-side default.
    function isAcceptedFollower(viewerId, ownerId) {
      return exists(/databases/$(database)/documents/follows/$(viewerId + '_' + ownerId)) &&
        get(/databases/$(database)/documents/follows/$(viewerId + '_' + ownerId)).data.get('status', 'accepted') != 'pending';
    }

    // Düzəliş Prompt 5 (K-3) — real, server-side block enforcement.
    // `blockedUsers` stays on the PUBLIC `users/{uid}` doc (Düzəliş
    // Prompt 4 deliberately left it there for exactly this reason — see
    // that field's own comment further down). Checks BOTH directions:
    // [a] having blocked [b], or [b] having blocked [a], either one is
    // enough. Two `get()`s (Variant A, chosen over a `blockedPair`
    // flag denormalized onto a chat doc — that flag can't be trusted as
    // the SOLE mechanism because a caller could simply never create the
    // chat doc and write straight into a subcollection/another
    // collection keyed off the same two uids, never triggering the
    // flag's own maintenance; reading each side's own `blockedUsers`
    // directly has no such bypass).
    // `exists()` guard — `get(path).data` throws when the doc is
    // genuinely absent (a deleted account, or a stale uid), which would
    // otherwise deny the WHOLE surrounding rule rather than just
    // treating a gone account as having no blocks. `exists()`/`get()`
    // on the same path within one rule evaluation are cached as a
    // single read, so this costs no more than a bare `get()` would.
    function blockedUsersOf(uid) {
      return exists(/databases/$(database)/documents/users/$(uid)) ?
        get(/databases/$(database)/documents/users/$(uid)).data.get('blockedUsers', []) : [];
    }

    function isBlockedPair(a, b) {
      return blockedUsersOf(a).hasAny([b]) || blockedUsersOf(b).hasAny([a]);
    }

    // RT-6 — "Kim mənə mesaj göndərə bilər" server-side, mirroring
    // `FirebaseChatRepository._canMessage`'s own client-side logic
    // (which only ever gated brand-new chat creation, never every
    // message — same scope kept here). `followersOnly` only blocks a
    // stranger from opening a NEW conversation; an existing accepted
    // chat is never retroactively closed by a later setting change.
    function canMessage(sender, other) {
      let whoCanMessageMe = exists(/databases/$(database)/documents/users/$(other)) ?
        get(/databases/$(database)/documents/users/$(other)).data.get('whoCanMessageMe', 'everyone') : 'everyone';
      return whoCanMessageMe != 'followersOnly' ||
        isAcceptedFollower(sender, other) || isAcceptedFollower(other, sender);
    }

    // `chats/{chatId}.participants` is always exactly the 2 sorted uids
    // (see `FirebaseChatRepository._sendMessage`) — picks whichever one
    // ISN'T `uid`.
    function otherOf(participants, uid) {
      return participants[0] == uid ? participants[1] : participants[0];
    }

    // Same "Hesab gizliliyi" gate as `stories/{storyId}`'s own `allow
    // read` (that rule's own doc comment explains the three-way check
    // this mirrors) — posts previously had none at all here, so a
    // private account's own feed posts were readable by any signed-in
    // user via a direct query, bypassing the app's client-side
    // `_MediaVisibilityGate`. Takes a postId (not the post's own
    // `resource.data`) so the SAME check can gate the `likes`/
    // `comments` subcollections below too, where the post's `userId`
    // isn't directly on `resource.data` — leaving those open would
    // still leak who liked/commented on a private account's post even
    // with the post document itself locked down.
    function canReadPost(postId) {
      let post = get(/databases/$(database)/documents/posts/$(postId)).data;
      return request.auth.uid == post.userId ||
        get(/databases/$(database)/documents/users/$(post.userId)).data.get('accountPrivacy', 'public') != 'private' ||
        isAcceptedFollower(request.auth.uid, post.userId);
    }

    // Server-side backstop for "Biznes fəaliyyəti" — the Flutter app
    // already hides every venue/offer-creation entry point in the UI
    // for `businessStatus == 'none'` (see `hasBusinessAccess` on
    // `UserProfile`), but that's UX only; this is what actually stops
    // a direct API call. Absent field (pre-migration accounts, or the
    // brief window before the backfill reaches a doc) defaults to
    // `'active'`, matching `hasBusinessAccess`'s own default — nobody
    // loses access because this field simply isn't set yet.
    function isBusinessUser(uid) {
      return exists(/databases/$(database)/documents/users/$(uid)) &&
        get(/databases/$(database)/documents/users/$(uid)).data.get('businessStatus', 'active') != 'none';
    }

    // ALLOWLISTS, replacing the three-item `isOfferOnlyCategory`
    // blacklist these call sites used to check.
    //
    // The blacklist answered "is this one of the three offer-only
    // categories" (wineHouse/homeServices/realEstate). The product rule
    // is narrower and positive: each feature has its own set of
    // permitted categories, held until now ONLY in the Flutter UI
    // (`kPinboxEligibleVenueCategories`, `config/eventCategories`).
    // PinBox and Event documents are created by DIRECT client writes,
    // so these rules were the entire server-side gate — and they let a
    // hotel, a gym or a clinic create either by skipping the UI.
    //
    // HAND-SYNCED MIRROR of `functions/src/venue-categories.ts` and of
    // `venue.dart`'s Dart sets. Rules cannot import either, so
    // `tests/rules/venue-categories.test.ts` parses all three files and
    // fails when any pair drifts. Change one, change all three.
    function isEventCategory(venueId) {
      return get(/databases/$(database)/documents/venues/$(venueId)).data.category
        in ['restaurant', 'pub', 'fastFood', 'cinema', 'nightClub', 'kidsEntertainment', 'independentArtist'];
    }

    function isPinBoxCategory(venueId) {
      return get(/databases/$(database)/documents/venues/$(venueId)).data.category
        in ['restaurant', 'coffeeShop', 'fastFood', 'sweetsShop', 'perfumeryCosmetics', 'supermarket'];
    }

    // P0 / H-5 — whether [url] points at THIS project's own Firebase
    // Storage bucket.
    //
    // Every media URL on a user-authored document (`users.photoUrl`,
    // `posts.mediaUrl`, `stories.mediaUrl`, and the venue/offer/PinBox/
    // event image fields handled server-side in functions/src/index.ts)
    // was previously an arbitrary string. Two consequences, both real:
    //   1. Tracking. These URLs are fetched with `NetworkImage` on
    //      OTHER users' devices — a marker on the nearby map, a search
    //      result, a chat list row. An external URL therefore turns
    //      every viewer into an HTTP request to a server the author
    //      controls, harvesting IP and User-Agent. For an app whose
    //      whole premise is proximity, that is a deanonymization
    //      primitive, not a nuisance.
    //   2. Moderation bypass. A moderator approves the BYTES currently
    //      at a URL. If the URL is remote, the author swaps those bytes
    //      afterwards with no Firestore write at all — nothing
    //      re-enters review, because `updateOffer`/`updateVenue`'s
    //      content diff sees an unchanged string.
    //
    // Matches the download-URL shape the Firebase SDK produces
    // (`getDownloadURL()`), which is the only thing any client here
    // ever writes. Bucket name is hardcoded — it is a constant of this
    // project, and a rules file has no way to read configuration.
    function isOwnStorageUrl(url) {
      return url is string &&
        url.matches('https://firebasestorage[.]googleapis[.]com/v0/b/kim-var-73ce9[.]firebasestorage[.]app/o/.*');
    }

    // Whether [uid] is a live, un-banned account (Düzəliş Prompt 11 /
    // Y-1) — `exists(users/{uid})` alone only catches a DELETED account
    // (the doc is gone); it does NOT catch a BANNED one, because
    // `setUserBanned` (admin-panel) only flips Firebase Auth's own
    // `disabled` flag and never touches Firestore — the `users/{uid}`
    // doc is untouched by a ban. `bannedUsers/{uid}` is a separate,
    // server-only tombstone written by that same action specifically so
    // rules have something to check; kept apart from `users/{uid}`
    // itself (rather than a `banned` field there) because that doc's
    // own read rule is `if request.auth != null` — any signed-in user
    // can read the whole document, so a field there would leak ban
    // status to anyone viewing the profile. This only gates a handful
    // of the highest-value abuse paths (see `bannedUsers` collection's
    // own comment below for which, and why not all of them) — it does
    // NOT close every write/read path for a banned/deleted account; the
    // remaining gap is documented at the deploy note at the bottom of
    // this file.
    function isActiveUser(uid) {
      return exists(/databases/$(database)/documents/users/$(uid)) &&
        !exists(/databases/$(database)/documents/bannedUsers/$(uid));
    }

    // App-wide config, read-only from the client — includes
    // `config/legal` (currentTermsVersion/currentPrivacyVersion, see
    // `lib/features/legal/legal_versions.dart` and
    // `consent_dialog.dart`'s re-consent check on Home mount),
    // `config/iapTesters` (Düzəliş Prompt 7 / H #196 —
    // `testerUids: string[]`, checked by `verifyInAppPurchase`,
    // functions/src/index.ts, before honoring an Apple Sandbox
    // transaction in production; harmless for the client to read, it
    // has no write path to it regardless), and `config/businessOffer`
    // (Düzəliş Prompt 10 / H #181 — `currentVersion`/`documentUrl`,
    // the canonical source `submitVenue`/`retryVenueSubscriptionPayment`
    // read instead of trusting whatever version/URL the client claims
    // was accepted).
    // Hand-edited via the Firebase Console (or a one-off admin script,
    // e.g. `admin-panel/scripts/set-iap-testers.ts`) — no client write
    // path exists or should exist.
    match /config/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Ban tombstone (Düzəliş Prompt 11 / Y-1) — existence alone means
    // "this uid is currently banned". Written only by the admin panel's
    // `setUserBanned` Server Action (Admin SDK, bypasses these rules) —
    // created on ban, deleted on un-ban. Same "no client read/write
    // path exists or should exist" shape as `admins/{uid}` below; the
    // ONLY thing any client-facing code ever does with this collection
    // is the `isActiveUser()` `exists()` check above, on a handful of
    // create rules chosen for highest abuse-per-write (chat messages,
    // calls, and the three report collections — a banned user filing
    // retaliatory reports is its own abuse vector, especially combined
    // with K-8's reputation-counter reasoning). Not every collection a
    // banned user could still write to is gated this way — see this
    // file's own deploy note at the bottom for what's deliberately left
    // for a later pass.
    match /bannedUsers/{uid} {
      allow read, write: if false;
    }

    match /users/{userId} {
      // Any signed-in user can read ONE profile by uid (needed to show
      // a single nearby user's card, a chat header, etc.). Düzəliş
      // Prompt 4 / K-1 narrowed what actually lives HERE, though —
      // email, phoneNumber, birthDate, exact lat/lng, fcmTokens,
      // knownDeviceSignatures, ghostModeEnabled/visibilityRadius*, and
      // most other self-preference fields moved to the owner-only
      // `private/data` subcollection below. This doc now only holds the
      // fields that are genuinely meant to be public (username, name,
      // bio, photo, badges, presence) plus `reportedCount` and
      // `blockedUsers` — both deliberately NOT moved despite being
      // sensitive (see their own comments further down for why each
      // stays here).
      //
      // Düzəliş Prompt 5 (K-3) — ONE direction only, matching the exact
      // spec: "bloklanan istifadəçi ... bloklayanın heç nəyini
      // görməməlidir" — the BLOCKED party can't read the BLOCKER's
      // profile. Deliberately NOT the reverse: the blocker can still
      // read the blocked party's own doc (name/photo), which
      // `blocked_users_screen.dart`'s own unblock list depends on to
      // show WHO each entry even is — making this symmetric would have
      // turned every row on that screen into an anonymous "İstifadəçi"
      // with no way to tell one blocked account from another before
      // deciding whether to unblock it. `messages`/`calls`/chat-create
      // (above) stay properly bidirectional — that's a fundamentally
      // different question ("can these two interact at all") from "can
      // this ONE viewer read that ONE profile".
      // `resource.data` (the TARGET's own list) is free — `resource` is
      // already being read for this very `get`, so this costs no extra
      // read at all: a blocked party sees the SAME permission-denied a
      // deleted/nonexistent account would (the client maps both to one
      // indistinguishable "Hesab tapılmadı", never revealing which — see
      // `UserProfileScreen`'s own doc comment, which handles the
      // `error` case from a blocked-403 and the `data == null` case
      // from a genuinely-missing doc identically).
      //
      // Fixed (post-launch QA, Qeydiyyat flow) — `resource` is `null`
      // for a `get` on a document that doesn't exist yet, and evaluating
      // `resource.data` on that `null` used to be an evaluation ERROR,
      // which Firestore denies exactly like a real block (fails closed).
      // That accidentally also caught the ONE self-read case this match
      // block was never meant to block: `_hydrateFromFirestore` reads
      // `users/{own uid}` right after `createUserWithEmailAndPassword`/
      // first Google-Apple sign-in, BEFORE `completeOnboarding` has ever
      // written that doc — so every brand-new registration hit this
      // same permission-denied and never got past the auth screen, even
      // though the Auth account itself had already been created. The
      // `resource == null ||` guard restores the intended "missing doc
      // reads as not-found" behavior WITHOUT weakening the block check
      // itself: an EXISTING doc still goes through the exact same
      // `blockedUsers` test as before.
      allow get: if request.auth != null &&
        (resource == null || !resource.data.get('blockedUsers', []).hasAny([request.auth.uid]));

      // RT-25 — a raw `list`/query against the WHOLE `users` collection
      // (e.g. `.where('lastSeen', ...)`) used to be allowed to any
      // signed-in client under the old combined `allow read`, meaning a
      // modified client (or a direct Firestore REST call) could
      // enumerate every public field of every user in one scan — the
      // exact "mass scraping" risk K-1 as a whole was about. Split from
      // `get` and closed outright: `findNearbyUsers`/
      // `getDiscoverCandidates`/`previewVenueAudience` (functions/src/
      // index.ts) now do this scan server-side via the Admin SDK, which
      // bypasses these rules entirely, so no legitimate client flow
      // ever needed `list` here — confirmed by exhaustive grep across
      // lib/ for every `.collection('users')` site: every single one
      // resolves to a `.doc(uid)` single-document read, never a bare
      // `.where()`/`.orderBy()` query against the collection itself.
      allow list: if false;

      // premium / identityVerified are grant-of-privilege fields (VIP,
      // identity badge) — a client write can NEVER touch them, not
      // even to set their own default `false`, so a raw Firestore call
      // can't self-grant either. Only Cloud Functions (Admin SDK,
      // which bypasses these rules) ever write them; every read site
      // already treats "absent" as `false`. `isVerified`/`phoneNumber`
      // used to be locked the same way (the old phone-OTP account-
      // verification step this app no longer has) — `phoneNumber` is
      // now a plain, self-reported, unverified profile field set once
      // at onboarding (see `completeOnboarding`), so it's free like any
      // other profile field; `isVerified` is unused dead data wherever
      // it still exists on old accounts.
      // `premiumExpiresAt` is the same lock again — only
      // `verifyInAppPurchase`/`appStoreServerNotifications`/
      // `googlePlayRtdn`/`expireLapsedPremium` (functions/src/index.ts)
      // ever write it, so a client can't extend its own VIP expiry.
      // `birthDate` joined this lock as part of the server-side minimum-age
      // gate (`completeOnboarding` Cloud Function) — immutable once set, so
      // neither a compromised nor a well-meaning client can back-date past
      // the age check after the fact. A wrong birth date now has to go
      // through support, not a client edit — see `completeOnboarding`'s own
      // doc comment for the age-check reasoning.
      // `reportedCount` joined the lock (Düzəliş Prompt 12 tapıntısı) —
      // Prompt 2 / K-8-in düzəlişi yalnız QEYRİ-sahib budağını
      // məhdudlaşdırmışdı (`hasOnly(['reportedCount']) + == +1`); sahib
      // budağı (`request.auth.uid == userId`) bu sahəni heç vaxt
      // qadağan edilmiş siyahıya salmamışdı, yəni hesab sahibi öz
      // `reportedCount`-unu sərbəst yaza (məs. sıfırlaya) bilirdi —
      // moderasiya siqnalını özü gizlədə bilərdi. Yeganə legitim yazıcı
      // (`firebase_safety_repository.dart:57`, `reportUser()`) HƏMİŞƏ
      // BAŞQA istifadəçinin sənədinə yazır (`reportedId`, `reporterId`
      // deyil) — özünü-şikayət `report_user_usecase.dart:15`-də
      // client-side artıq bloklanır, VƏ struktur olaraq belə bu yazı
      // heç vaxt sahib budağından keçə bilməz (`request.auth.uid !=
      // userId` şərti onu artıq istisna edir) — ona görə bu kilid
      // legitim axını sındırmır, yalnız sahibin öz-özünü təmizə
      // çıxarma yolunu bağlayır.
      function touchesLockedUserFields() {
        // `birthDate` KEPT here (P0 / H-9) even though Düzəliş Prompt 4
        // moved the live field to `users/{uid}/private/data`. Removing
        // it was tried and reverted: this file's rules-test suite caught
        // that it would open a real fallback hole. `withPrivateData`
        // (functions/src/index.ts) merges the two documents as
        // `{...publicDoc, ...privateDoc}`, so a `birthDate` sitting on
        // the PUBLIC document is still used by
        // `ageYearsFromBirthDate`/`buildPublicCandidatePayload` whenever
        // the private one has none — an un-migrated account, or simply a
        // private doc where the field is absent. Leaving this open would
        // therefore have restored exactly the age-spoofing vector the
        // subcollection lock exists to close, just via a different path.
        // Both locations are now locked; neither alone is sufficient.
        return request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['premium', 'identityVerified', 'premiumExpiresAt', 'birthDate', 'reportedCount']);
      }

      // Defense-in-depth (Düzəliş Prompt 8 / RT-2) — matches the
      // client's own existing `maxLength: 200` on the bio field
      // (edit_profile_screen.dart) exactly, so this changes nothing for
      // the real app; it only closes the gap for a modified/raw client.
      function bioSizeOk() {
        return !('bio' in request.resource.data) || request.resource.data.bio.size() <= 200;
      }

      // A handle displayed here must actually be HELD in `usernames`.
      //
      // `usernames/{lowercased}` is the reservation ledger — its create
      // rule already makes a handle unique and binds it to one uid
      // (`resource == null && request.auth.uid == request.resource.data
      // .uid`). But nothing tied THIS document's `username` field to
      // that ledger, and `username` was not in
      // `touchesLockedUserFields()` either. So a modified client could
      // simply write `username: "someone_elses_handle"` here, skipping
      // the reservation entirely, and every surface that renders an
      // @handle — public profile, `searchUsersByName`/
      // `searchUsersByUsername` results (both read `users.username`,
      // see `buildSearchProfilePayload`), the share card, chat rows —
      // would show it. `isReservedUsername`'s blocklist ('admin',
      // 'support', 'peakpin', …) was bypassed the same way, since it
      // only ever guarded the ledger. Verified in the emulator: writing
      // both an unreserved handle and one reserved by another account
      // succeeded before this rule.
      //
      // Enforced HERE rather than by moving username changes into a
      // callable, which was the other candidate. `updateUsername`
      // (`firebase_auth_repository.dart`) is a two-step client flow —
      // reserve, then write this field — and that flow is what the
      // build already in the store runs. A callable would be the
      // cleaner shape, but it would also mean no shipped install could
      // change its username until users updated. This rule makes the
      // EXISTING flow safe, which is the change that can go out today;
      // the callable stays worth doing later, and this rule keeps
      // holding when it lands (the Admin SDK bypasses rules).
      //
      // Costs one `get()`, and only on a write that actually changes
      // the field — `affectedKeys()` compares values, and rules
      // short-circuit `||`, so ordinary profile saves (which don't
      // touch `username` at all — see `ProfileController.save`) pay
      // nothing.
      function usernameOwnedByCaller() {
        return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['username']) ||
          (
            request.resource.data.username is string &&
            exists(/databases/$(database)/documents/usernames/$(request.resource.data.username.lower())) &&
            get(/databases/$(database)/documents/usernames/$(request.resource.data.username.lower())).data.uid == request.auth.uid
          );
      }

      // `nameLower` must stay the derivative of the name actually shown.
      //
      // Same class as the venue `nameLower` lock two hundred lines
      // below (P0 / C-d) — that one was closed, this one was not, so
      // the sweep was half-finished. `searchUsersByName` orders and
      // range-scans on `nameLower` and NEVER on `firstName`/`lastName`
      // (functions/src/index.ts), so the two fields answer different
      // questions: one is what a viewer reads on the profile, the other
      // is what the account is findable by. Left unbound, an account
      // could display one identity and be indexed under another —
      // surfacing in searches for a specific real person while showing
      // something else, or dropping out of search entirely.
      //
      // NOT a blocklist entry, and not derived in a trigger. Both would
      // reject the write that `ProfileController.save` already sends
      // (it sets `firstName`/`lastName`/`nameLower` in ONE batch, see
      // profile_providers.dart), breaking profile editing for every
      // install currently in the store; a trigger would additionally
      // leave search stale for as long as it takes to fire. Requiring
      // the value to EQUAL the derivation gets the same invariant, with
      // the shipped client already computing exactly this expression
      // ('$firstName $lastName'.trim().toLowerCase()).
      //
      // This does not stop someone from choosing a misleading display
      // name — no consumer app does, users rename themselves — it stops
      // the display name and the search key from disagreeing.
      function nameLowerMatchesName() {
        return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['nameLower']) ||
          request.resource.data.nameLower ==
            (request.resource.data.get('firstName', '') + ' ' + request.resource.data.get('lastName', '')).trim().lower();
      }

      // No client `create` path exists any more — `completeOnboarding`
      // (Cloud Function, Admin SDK, bypasses these rules) is the ONLY way a
      // `users/{uid}` document comes into existence, specifically so its
      // server-side minimum-age check (18+, see that function) can't be
      // skipped by writing the document directly. A user can still delete
      // their own document (`deleteAccount` also does this, via Admin SDK).
      allow create: if false;
      allow delete: if request.auth != null && request.auth.uid == userId;

      // A user can update their own document freely (including their
      // own `blockedUsers` array) EXCEPT the locked fields above. Any
      // OTHER signed-in user may update it too, but only to bump
      // `reportedCount` by exactly 1 (filing a report via
      // `firebase_safety_repository.dart`'s `reportUser()`) — every
      // other field stays owner-only.
      //
      // `blockedUsers` STAYS on this doc (Düzəliş Prompt 4 / K-1 —
      // deliberately NOT moved to `private/data`, flagged not silently
      // decided) — `firebase_chat_repository.dart`'s own `_isBlockedPair`
      // (its message-send guard, separate from the one in
      // `location_providers.dart`) reads the OTHER party's `blockedUsers`
      // directly from this doc before allowing a send. Moving it to the
      // owner-only subcollection would make that read fail outright,
      // breaking message sending. Real server-side block enforcement
      // (this field should never have been client-checkable in the
      // first place) is Prompt 5's stated scope ("Blok mexanizmi server
      // tərəfə") — left exactly as-is here so as not to preempt that
      // work with a half fix.
      //
      // `starCount`/`heartCount`/`dislikeCount` were dropped from this
      // branch (Düzəliş Prompt 2 / K-8) — the swipe/card feature they
      // backed no longer exists anywhere in the client (confirmed by an
      // exhaustive grep: every remaining reference is a read-only
      // parsed field, no write path left at all), so there is no
      // legitimate writer to preserve. Their removal also closes a real
      // logic flaw: with all four fields under one `hasOnly` and an
      // `||`-joined per-field `+1` check, satisfying ANY ONE of the
      // four (e.g. `reportedCount`) passed the whole condition while
      // `hasOnly` only constrained the KEY SET, not each field's VALUE
      // — so the same write could set the other three to anything. With
      // only `reportedCount` left, `hasOnly` + a single equality check
      // is airtight.
      // `photoUrl` must be one of OUR Storage objects (P0 / H-5) — this
      // is the highest-traffic instance of the problem, since a profile
      // photo renders on every map marker, search result and chat row
      // that mentions this account.
      //
      // Checked only when the write CHANGES it, not on every update.
      // The difference matters: `request.resource.data` carries the
      // whole post-write document, so validating unconditionally would
      // mean any account that already holds a non-Storage `photoUrl`
      // could never edit its bio, city or anything else again — locked
      // out by a value it cannot fix in the same write. No such account
      // is expected (the only writer is
      // `FirebaseStorageRepository`'s `profile_photos/{uid}/profile.jpg`
      // upload; Google/Apple sign-in photos are NOT copied here —
      // verified by grep), but "expected" is not "verified in
      // production", and `npm run list-external-media-urls` exists to
      // answer that with data. Grandfathering costs nothing defensively:
      // an attacker's goal is to INTRODUCE an external URL, and that is
      // exactly what this rejects.
      function photoUrlOk() {
        return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['photoUrl']) ||
          request.resource.data.photoUrl == null ||
          isOwnStorageUrl(request.resource.data.photoUrl);
      }

      allow update: if request.auth != null && (
        (request.auth.uid == userId && !touchesLockedUserFields() && bioSizeOk() && photoUrlOk() &&
          usernameOwnedByCaller() && nameLowerMatchesName()) ||
        (
          request.auth.uid != userId &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reportedCount']) &&
          request.resource.data.reportedCount == ('reportedCount' in resource.data ? resource.data.reportedCount : 0) + 1
        )
      );

      // Private data (Düzəliş Prompt 4 / K-1) — email, phoneNumber,
      // birthDate, exact lat/lng, fcmTokens, knownDeviceSignatures,
      // ghostModeEnabled/visibilityRadius*, and other fields that used
      // to sit directly on `users/{uid}` (fully world-readable per the
      // rule above) now live here instead — YALNIZ sahib. Mirrors the
      // already-proven `payments`/`sessions` owner-only-subcollection
      // shape this schema already uses successfully. `blockedUsers`
      // deliberately STAYS on the parent doc, NOT here — see that
      // field's own note further down for why (Prompt 5's territory).
      // P0 / H-9 (REGRESSION) — this used to be a bare `allow read,
      // write: if request.auth.uid == userId`, which is where Düzəliş
      // Prompt 4's migration quietly lost a guarantee. The fields it
      // moved here (`birthDate` above all) were previously protected on
      // the PARENT document by `touchesLockedUserFields()`; that lock is
      // bound to a PATH, not to a field, so it did not travel with them
      // — `firestore.rules` went on listing `'birthDate'` in a blocklist
      // for a document that no longer contained it. Net effect: the 18+
      // gate `completeOnboarding` enforces could be undone by the very
      // next client write, and `consent` (a legal record), `email` and
      // `phoneNumber` (both surfaced to admins/support) became
      // self-declared.
      //
      // Now field-scoped. Each name below is server-only because a
      // specific consumer trusts it, not because it "looks sensitive":
      //   `birthDate`   — the minimum-age gate; only `completeOnboarding`
      //                   (and support) may ever set it.
      //   `phoneNumber` — shown to moderators in the admin panel.
      //   `email`       — same, and now written by `syncContactEmail`
      //                   from `request.auth.token`, which can't be forged.
      //   `consent`     — legal acceptance record; `recordConsent` reads
      //                   the versions from `config/legal` rather than
      //                   believing the client's claim.
      //   `loginProvider` — derived from the Auth record.
      //   `fcmTokens`   — the push-delivery target list; a client write
      //                   could add ANOTHER user's device token
      //                   (`registerFcmToken`/`unregisterFcmToken` now
      //                   own it).
      //   `knownDeviceSignatures` — the "new device sign-in" alert's own
      //                   memory; a client write silences that alert.
      //   `blockedByUsers` — the reverse block index (`onUserUpdated`
      //                   writes it onto the BLOCKED party's doc, so the
      //                   blocked party must not be able to clear it).
      //
      // Everything else stays client-writable, including `lat`/`lng`
      // (locking them buys nothing — a rooted device spoofs GPS at the
      // OS level and the server cannot tell the difference; the real
      // mitigation is on the disclosure side, see `findNearbyUsers`) and
      // `activeCheckinVenueId` (written by the client's own check-in
      // transaction alongside the `activeCheckins` doc it points at;
      // self-referential, and the Cloud Function triggers reconcile it).
      //
      // The `resource == null` branch handles first creation: this
      // document is legitimately created by whichever client writer runs
      // first (re-consent, location, telemetry), often BEFORE
      // `completeOnboarding` — see that function's own `tx.set(merge:
      // true)` comment for the incident that established this.
      match /private/{document} {
        // Split into separate create/update rules rather than one
        // `write` with a `resource == null ? ... : ...` ternary: the
        // ternary mixed a List (`keys()`) with a Set
        // (`diff().affectedKeys()`) in its two branches, and every other
        // block in this file already states create and update
        // separately. (Both shapes deny correctly — the emulator's
        // "evaluation error" lines against split rules are just it
        // reporting the NON-matching rule, e.g. the update rule's
        // `resource.data` on a create; every pre-existing split rule in
        // this file logs the same thing.)
        function serverOnlyFields() {
          return [
            'birthDate', 'phoneNumber', 'email', 'consent', 'loginProvider',
            'fcmTokens', 'knownDeviceSignatures', 'blockedByUsers',
            // Read-side mirror of `bannedUsers/{uid}` — see
            // `setUserBanned` (admin panel) for why it lives on the
            // OWNER-ONLY private doc rather than the public one, and
            // which of the two is authoritative. It must be here: the
            // owner can write every other field of this document, so
            // without this line a banned user would simply delete the
            // flag that hides them from Discover.
            'banned'
          ];
        }

        allow read: if request.auth != null && request.auth.uid == userId;

        // First creation — often by a client writer that runs BEFORE
        // `completeOnboarding` (re-consent, location, telemetry); see
        // that function's own `tx.set(merge: true)` comment.
        allow create: if request.auth != null && request.auth.uid == userId &&
          !request.resource.data.keys().hasAny(serverOnlyFields());

        allow update: if request.auth != null && request.auth.uid == userId &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(serverOnlyFields());

        // Owner-only, EXCEPT while the account is banned.
        //
        // `serverOnlyFields()` includes `banned` and so protects it on
        // create and update — but delete was left open on the reasoning
        // that `deleteAccount` bypasses these rules anyway, so nothing
        // was gained by forbidding it. That reasoning missed that
        // delete-then-recreate is a way to CLEAR a protected field
        // without ever writing it: `create` only requires that
        // serverOnly keys be ABSENT, and an absent `banned` is exactly
        // what a banned account wants. Confirmed in the emulator —
        // delete succeeded, then a recreate with `{lat, lng}` and no
        // `banned` succeeded too.
        //
        // What that buys the attacker is visibility, not permission.
        // `bannedUsers/{uid}` stays the source of truth and still gates
        // every write via `isActiveUser()`. But `findNearbyUsers` and
        // `getDiscoverCandidates` filter candidates on the CHEAP mirror
        // (`private/data.banned`, already fetched by `withPrivateData`)
        // rather than paying a `bannedUsers` read per candidate — see
        // those filters' own comments. Clearing the mirror puts a
        // banned account back into everyone's Discover and nearby
        // results, which for a ban issued over harassment is precisely
        // the outcome the ban existed to prevent.
        //
        // `deleteAccount` is unaffected: Admin SDK, bypasses rules. A
        // banned user who wants their data gone still has that path.
        allow delete: if request.auth != null && request.auth.uid == userId &&
          !exists(/databases/$(database)/documents/bannedUsers/$(userId));
      }

      // Personal media gallery grid on the self-profile tab — read-only
      // from the client for now (no upload flow exists yet, so this
      // sits empty until one is built). Owner-only write, any signed-in
      // user can read, matching the parent doc's read rule.
      match /media/{mediaId} {
        allow read: if request.auth != null;
        allow create, update, delete: if request.auth != null && request.auth.uid == userId;
      }

      // Favorited offers — same owner-read/write-only shape as
      // `favorites` above, kept in its own subcollection rather than
      // reused since venue and offer ids are unrelated auto-ids from
      // different collections (see `OfferRemoteDatasource
      // .watchFavoriteOfferIds`'s doc comment). No denormalized
      // counter to keep in sync here (offers have no `favoriteCount`
      // field), so this is a plain single write, not a pair.
      match /favoriteOffers/{offerId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Reverse index for the "Bəyəndikləri" profile tab — mirrored here
      // by `onPostLikeCreated`/`onPostLikeDeleted` (functions/src/index.ts)
      // whenever this user likes/unlikes a post, since a client-side
      // `collectionGroup("likes")` query can't be proven safe by rules
      // (same reason the `posts` collection's own cross-user list query is
      // blocked below). Admin SDK writes bypass rules, so `allow write:
      // if false` only blocks the client.
      match /likedPosts/{postId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if false;
      }

      // "Repostlar" profile tab — same owner-read/write-only shape as
      // `favoriteOffers` above; the client toggles this directly, exactly
      // like `posts/{postId}/likes/{uid}` toggles a like. `create` also
      // checks the target post's own `userId` — reposting your own post
      // is blocked here, not just hidden client-side (`post_reel_item
      // .dart`'s `_RightActionRail` never even shows the button for an
      // owner's own post, but a rule is what actually enforces it).
      match /reposts/{postId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null && request.auth.uid == userId &&
          get(/databases/$(database)/documents/posts/$(postId)).data.userId != userId;
        allow delete: if request.auth != null && request.auth.uid == userId;
      }

      // Social/system notification inbox (follow, likes, comments,
      // venue events, security/system alerts — never message-related,
      // see the Söhbət module's own delivery/read-receipt fields for
      // that). Every doc is written server-side (Cloud Functions on
      // the Admin SDK, which bypasses these rules entirely) — the
      // client never creates one. The only client write allowed is
      // flipping `isRead`, and only that field; deleting a doc (used
      // by "Oxunmuşları sil") is otherwise unrestricted to the owner.
      match /notifications/{notificationId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create: if false;
        allow update: if request.auth != null && request.auth.uid == userId &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']);
        allow delete: if request.auth != null && request.auth.uid == userId;
      }

      // Per-venue 24h throttle for the "new offer near you" fanout
      // (`notifyNearbyUsersOfNewOffer`, functions/src/index.ts) —
      // written exclusively by that Cloud Function (Admin SDK bypasses
      // these rules), purely internal bookkeeping the client never
      // needs to read or write.
      match /notifiedVenues/{venueId} {
        allow read, write: if false;
      }

      // Same "internal bookkeeping only" shape as notifiedVenues above,
      // for `notifyNearbyUsersOfNewEvent`'s permanent (not 24h-rolling)
      // per-event dedup — see that function's doc comment.
      match /notifiedEvents/{eventId} {
        allow read, write: if false;
      }

      // Payment/subscription history — sensitive financial data, so
      // unlike media/stories this is owner-read-only, not "any signed-in
      // user". No client write at all: only the (not-yet-built) purchase
      // -verification Cloud Function, running as Admin SDK, will ever
      // write here — Admin SDK bypasses rules entirely, so `allow
      // write: if false` doesn't block it, only client writes.
      match /payments/{paymentId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if false;
      }

      // "Aktiv cihazlar" — a device writes/refreshes its OWN entry via
      // touchCurrentSession(), and the owner (from any of their own
      // devices) can delete any entry under their own uid to trigger a
      // remote sign-out (see SessionGuard for the client-side half of
      // that). Owner-only in both directions — nobody else's session
      // list is any of another user's business.
      match /sessions/{sessionId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // "Profilimə baxanlar" — doc id is the VIEWER's uid, so repeat
      // visits update the same doc instead of piling up duplicates.
      // Owner-read-only (this is exactly the private data the feature
      // exists to expose only to them); a signed-in user may only ever
      // write their OWN entry, and never on their own profile (viewing
      // yourself isn't a "visit").
      // Which birthday-targeted offers THIS user may see.
      //
      // Replaces the `offers.targetUserIds` array, which was the list
      // of uids whose birthday is today, sitting on a document whose
      // rule is `allow read: if request.auth != null`. `birthDate` was
      // deliberately moved to `private/data` as PII; that array put the
      // same fact back in public view for anyone who read the offer.
      //
      // Inverting it — a marker in each recipient's own space instead
      // of a roster on the shared document — gives the client the same
      // yes/no it needs while telling nobody about anyone else.
      // Server-written only (`notifyBirthdayTargetUsers`); the raw list
      // lives in `offers/{offerId}/private/targeting`, which is closed
      // to every client.
      match /birthdayOffers/{offerId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if false;
      }

      match /profileViews/{viewerId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create, update: if request.auth != null &&
          request.auth.uid == viewerId &&
          request.auth.uid != userId &&
          request.resource.data.keys().hasOnly(['viewerId', 'viewedAt']) &&
          request.resource.data.viewerId == viewerId;
        allow delete: if false;
      }
    }

    // Username → uid + authEmail reservation, doc id is the username
    // lowercased. Public read on purpose (`allow get: if true`) —
    // both the register screen's availability check AND login's
    // authEmail lookup happen BEFORE the client is signed in, so this
    // can't require `request.auth != null`. `authEmail` is the random,
    // never-shown synthetic address the account actually signs in
    // with (see FirebaseAuthRepository) — deliberately NOT derived
    // from the username, so renaming (`updateUsername`: new doc with
    // the same authEmail, old one deleted) never touches the sign-in
    // credential, unlike a real address this can be safely public:
    // it's useless without the password too.
    // `consent` (added alongside the original 3 fields) is the
    // registration-screen checkbox's record — parked here rather than
    // on `users/{uid}` because that doc doesn't exist yet at
    // registration time (see `FirebaseAuthRepository.registerWithUsername`'s
    // doc comment); `completeOnboarding` reads it back from here and
    // copies it onto `users/{uid}.consent` once that doc is created.
    // Public @handle reservation — no longer a sign-in credential
    // lookup (that was the pre-rewrite username+password scheme; see
    // AuthRepository's own doc comment), just enforces uniqueness:
    // `create` fails outright if a doc already exists at this id,
    // which is the actual race-safe guarantee `isUsernameAvailable`'s
    // client-side check only approximates.
    // Düzəliş Prompt 10 / AUTH-6 — kept in sync BY HAND with
    // `RESERVED_USERNAMES` in functions/src/index.ts (same
    // "duplicate table across two runtimes" shape as
    // `venueSubscriptionFeeByCategory`'s own doc comment there) —
    // `completeOnboarding` (Admin SDK) already blocks these at
    // signup, but `updateUsername` (`FirebaseAuthRepository`) writes
    // this doc DIRECTLY from the client with no Cloud Function in the
    // path at all, so this is the ONLY enforcement point for that one
    // flow. `usernameId` is already lowercase (the doc id IS the
    // lowercased username), so this list only needs lowercase entries.
    function isReservedUsername(usernameId) {
      return usernameId in [
        'admin', 'administrator', 'support', 'help', 'helpdesk', 'peakpin',
        'moderator', 'mod', 'official', 'team', 'staff', 'system', 'root',
        'security', 'info', 'contact', 'billing', 'privacy', 'legal',
        'abuse', 'noreply', 'null', 'undefined'
      ];
    }

    match /usernames/{usernameId} {
      // `get` stays public (Düzəliş Prompt 2 / Quick Win 1 — deliberately
      // NOT tightened) — `deep_link_handler.dart`'s `_openProfileByUsername`
      // runs a single-doc `get()` here for shared `peakpin.app/u/{username}`
      // links, BEFORE any sign-in check, including for a user who has
      // never signed in at all. Requiring `request.auth != null` would
      // silently break that flow for logged-out users (the client
      // catches the resulting error and no-ops rather than crashing, but
      // the profile just never opens). Every OTHER read site
      // (`isUsernameAvailable`, `updateUsername`) already runs
      // authenticated, so this stays open specifically for the
      // logged-out deep-link case.
      allow get: if true;

      // `list` is a SEPARATE permission from `get` in Firestore rules
      // (both fall under `read`, but neither implies the other) — the
      // discover/search screen's username-prefix query (`orderBy(
      // FieldPath.documentId).startAt/endAt(...)`, in
      // FirebaseDiscoverSearchRepository) is a `list`, so without this
      // it was rejected outright with permission-denied, silently
      // surfacing as "no results found" in the app (the query's error
      // is caught and swallowed into an empty result list). Doc IDs
      // here are just lowercase username strings and each doc is only
      // `{uid, createdAt}` — nothing sensitive to gate behind auth.
      //
      // CLOSED OUTRIGHT (P0 / H-6). Düzəliş Prompt 2 narrowed this from
      // fully-public to any-signed-in-user, which was the wrong axis:
      // the problem was never authentication, it was enumeration. Doc
      // ids here ARE usernames and each doc carries the uid, so
      // `orderBy(documentId).startAt([''])` plus paging yielded the
      // complete `username → uid` index for the entire user base —
      // and every uid then resolved to a full public profile through
      // the single-doc `get` on `users/{uid}` (which still exposes
      // `blockedUsers` and `reportedCount`). That made RT-25's
      // `allow list: if false` on `users` itself a one-hop detour
      // rather than a closed door.
      //
      // The only caller was `FirebaseDiscoverSearchRepository
      // .searchUsersByUsername`, now served by the callable of the same
      // name (functions/src/index.ts) — which applies a result cap and
      // a bidirectional block filter the raw query never did.
      //
      // `allow get` above stays OPEN on purpose (see its own comment and
      // docs/ACCEPTED_RISKS.md): resolving one already-known username
      // for a shared `peakpin.app/u/{username}` link is public profile
      // discovery. Listing every username is identity enumeration.
      allow list: if false;

      allow create: if request.auth != null &&
        resource == null &&
        !isReservedUsername(usernameId) &&
        request.auth.uid == request.resource.data.uid &&
        request.resource.data.keys().hasOnly(['uid', 'createdAt']);
      allow delete: if request.auth != null && request.auth.uid == resource.data.uid;
      allow update: if false;
    }

    // One-directional follow graph — the app's only "connection"
    // concept now (the old mutual friendRequests/swipes collections
    // were removed). Doc id is `{followerId}_{followeeId}` (NOT
    // sorted — direction matters), so a user following and being
    // followed back by the same person are two independent docs.
    //
    // `status` ("Hesab gizliliyi" / FAZA 4): `accepted` for an instant
    // follow of a `public` account, `pending` for a request against a
    // `private` one — every edge created before this feature has no
    // `status` field at all and is treated as `accepted` everywhere
    // that reads it (client and rules alike).
    match /follows/{followId} {
      // A followers-of-B list query returns docs with `followeeId==B`
      // (gate on B's own privacy); a following-of-A list query returns
      // docs with `followerId==A` (gate on A's). Granting on EITHER
      // side being public/accepted-followed is correct, not a leak —
      // it's "you may see this edge if you have legitimate access to
      // either list it could appear on", same reasoning `canReadPost`
      // above already uses for one resource instead of two.
      //
      // Fixed (post-launch QA, same class as `users/{userId}` above) —
      // `followId` is deterministic (`{followerId}_{followeeId}`), so
      // "do I follow X" is routinely checked by `.get()`-ing an ID that
      // simply doesn't exist yet (no relationship). Without the
      // `resource == null ||` guard, that legitimate not-a-follow case
      // hit the same evaluation-error-as-permission-denied failure mode
      // as an actual block, and the client had no way to tell "no
      // relationship" apart from a rules bug.
      allow read: if request.auth != null && (
        resource == null ||
        request.auth.uid == resource.data.followerId ||
        request.auth.uid == resource.data.followeeId ||
        get(/databases/$(database)/documents/users/$(resource.data.followeeId)).data.get('accountPrivacy', 'public') != 'private' ||
        get(/databases/$(database)/documents/users/$(resource.data.followerId)).data.get('accountPrivacy', 'public') != 'private' ||
        isAcceptedFollower(request.auth.uid, resource.data.followeeId) ||
        isAcceptedFollower(request.auth.uid, resource.data.followerId)
      );

      // `status: 'accepted'` is only valid straight off a `public`
      // followee — a `private` one always starts `pending`, no matter
      // what the write claims (Düzəliş Prompt 2 / K-5). Before this,
      // `status` was accepted as sent, entirely trusting the client's
      // own `follow_action_button.dart` decision — a modified client
      // could self-grant instant access to a private account.
      // `isActiveUser()` (self-verification / d4) — a follow raises a
      // notification on a named person's device, which makes it the
      // cheapest post-ban harassment primitive in the app. Low write
      // frequency, so the two extra reads this costs are affordable
      // here in a way they are not on likes/views (see
      // `ACCEPTED_RISKS.md` for the paths deliberately left open).
      allow create: if request.auth != null &&
        isActiveUser(request.auth.uid) &&
        request.auth.uid == request.resource.data.followerId &&
        request.resource.data.followeeId != request.resource.data.followerId &&
        followId == request.resource.data.followerId + '_' + request.resource.data.followeeId &&
        request.resource.data.status in ['accepted', 'pending'] &&
        (request.resource.data.status == 'pending' ||
         get(/databases/$(database)/documents/users/$(request.resource.data.followeeId)).data.get('accountPrivacy', 'public') != 'private');

      // Only the followee may accept — flips a `pending` request to
      // `accepted`, nothing else about the doc may change.
      allow update: if request.auth != null &&
        request.auth.uid == resource.data.followeeId &&
        resource.data.status == 'pending' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']) &&
        request.resource.data.status == 'accepted';

      // The follower can always remove the edge (unfollow an accepted
      // one, or cancel their own still-pending request). The followee
      // may ALSO delete it regardless of status — a still-pending one
      // (declining the request) or an already-accepted one ("Çıxart",
      // removing a follower).
      allow delete: if request.auth != null && (
        request.auth.uid == resource.data.followerId ||
        request.auth.uid == resource.data.followeeId
      );
    }

    // 1:1 chats — id is the two participant uids sorted and joined
    // with "_", so there's exactly one chat doc per pair.
    match /chats/{chatId} {
      // `resource` is null when the chat doc doesn't exist yet — which is
      // the normal case for a brand-new conversation's first message,
      // where FirebaseChatRepository's send transaction does
      // tx.get(chatRef) before deciding whether to create or update it.
      // Without the `resource == null ||` guard, `resource.data.participants`
      // throws on that null resource, the rule evaluates to a denial, and
      // the get() itself — the very first operation in the transaction —
      // fails with permission-denied, aborting the whole send before any
      // write is even attempted. Verified against the Firestore emulator:
      // the old rule errors with "Null value error" on this exact get();
      // the guarded version returns exists:false with no error.
      allow read: if request.auth != null &&
        (resource == null || request.auth.uid in resource.data.participants);

      // Düzəliş Prompt 5 (K-3/RT-6) — a blocked pair (either direction)
      // may never open a new conversation, and `whoCanMessageMe:
      // followersOnly` is enforced for real (was client-only before —
      // `FirebaseChatRepository._canMessage`, easily bypassed by a
      // direct write). Both checks only apply at CREATE — an already-
      // `accepted` chat is never retroactively closed by a later block
      // (see `messages/create` below for that) or setting change.
      // P0 / H-3 — `participants` must be exactly the two uids the
      // document id is built from, sorted. `FirebaseChatRepository`
      // already builds both that way (`chatIdFor` sorts and joins with
      // "_"), so this breaks nothing real; it closes the gap where a
      // chat document's membership list and its own id could disagree,
      // which is what made the `update`-side rewrite above reachable in
      // a shape the `messages` rules (which parse `chatId` itself) could
      // not detect.
      // `isActiveUser()` (self-verification / d4). `messages` under
      // this document has been gated since C-3; the parent had not,
      // which is a half-applied protection rather than a decision — a
      // banned user could still make a conversation appear in someone
      // else's list, just an empty one. One conversation per pair, so
      // the write frequency is as low as it gets.
      allow create: if request.auth != null && isActiveUser(request.auth.uid) &&
        request.auth.uid in request.resource.data.participants &&
        request.resource.data.participants.size() == 2 &&
        chatId == request.resource.data.participants[0] + '_' + request.resource.data.participants[1] &&
        request.resource.data.participants[0] < request.resource.data.participants[1] &&
        !isBlockedPair(request.resource.data.participants[0], request.resource.data.participants[1]) &&
        canMessage(request.auth.uid, otherOf(request.resource.data.participants, request.auth.uid));

      // Two distinct kinds of update, both restricted to participants:
      //  1. Ordinary chat activity (sending a message, typing, receipts,
      //     unread counters) — `status` must stay exactly as it was.
      //  2. Accept/decline of a pending request — ONLY the participant
      //     who is NOT `initiatorId` may do this (the sender can never
      //     accept/decline their own request), only while the request
      //     is still `pending`, and the write may touch `status` and
      //     nothing else.
      // Düzəliş Prompt 5 — a blocked pair can no longer accept a still-
      // pending request into an `accepted` chat (declining stays
      // allowed either way — that only closes the door further).
      //
      // Post-launch QA — `lastMessageOverride` (each participant's OWN
      // "məndən sil" chat-list preview override, written exclusively by
      // `onChatMessageDeletedForUser`, Admin SDK) is explicitly excluded
      // from branch 1's otherwise-broad "any field, `status` unchanged"
      // grant. Without this, either participant could write into it
      // directly and show the OTHER participant a fabricated preview
      // text in their own chat list — the field only means anything
      // because it's guaranteed to have been computed server-side from
      // what that uid can actually no longer see, never hand-picked.
      // P0 / H-3 — `participants` and `initiatorId` are now pinned on
      // BOTH branches (see the shared guard in the outer condition
      // below), mirroring what `calls/{callId}`'s own update rule has
      // always done. Without it, branch 1's "any field as long as
      // `status` is unchanged" grant included the membership list
      // itself: a caller could take a chat they legitimately own and
      // rewrite `participants` to `[self, anyone]`, then set
      // `lastMessage`/`lastMessageAt`/`unreadCount` freely. Because the
      // chat list is a plain `where('participants', arrayContains: uid)`
      // query, that put an unread conversation carrying
      // attacker-written preview text into ANY user's inbox — bypassing
      // `isBlockedPair`, `whoCanMessageMe: followersOnly`, and the
      // recipient having previously deleted the chat, all of which
      // Düzəliş Prompt 5 enforces only on `create` and on
      // `messages/create`.
      // P0 / H-4 — "Söhbəti sil" is now a PER-USER hide, and this is the
      // only way a client may touch `hiddenFor`.
      //
      // The map is keyed by uid exactly like `pinnedBy`/`archivedBy`/
      // `mutedBy`, but unlike those it is a safety-relevant field, so
      // "only your own key" is enforced rather than assumed: a
      // harasser must not be able to hide the conversation from their
      // VICTIM (destroying the victim's view of the evidence), and must
      // not be able to clear the victim's own hide either (dragging a
      // conversation the victim removed back into their list). Both
      // directions are blocked by the same `diff().affectedKeys()
      // .hasOnly([request.auth.uid])` check on the MAP itself, not just
      // on the field name.
      //
      // `.get('hiddenFor', {})` because the field is absent on every
      // chat created before this change — a bare `resource.data
      // .hiddenFor` would error (and therefore deny) for all of them.
      function touchesOnlyOwnHiddenFlag() {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hiddenFor']) &&
          request.resource.data.hiddenFor.diff(resource.data.get('hiddenFor', {}))
            .affectedKeys().hasOnly([request.auth.uid]);
      }

      allow update: if request.auth != null && request.auth.uid in resource.data.participants &&
        request.resource.data.participants == resource.data.participants &&
        request.resource.data.initiatorId == resource.data.initiatorId && (
        (
          request.resource.data.status == resource.data.status &&
          // `hiddenFor` joins `lastMessageOverride` in branch 1's
          // exclusion list — branch 1 is the broad "ordinary chat
          // activity" grant, and without this it would let either
          // participant rewrite the whole map, which is precisely what
          // the dedicated branch below exists to prevent.
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['lastMessageOverride', 'hiddenFor'])
        ) ||
        (
          resource.data.status == 'pending' &&
          request.auth.uid != resource.data.initiatorId &&
          request.resource.data.status in ['accepted', 'declined'] &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']) &&
          (request.resource.data.status == 'declined' ||
           !isBlockedPair(resource.data.participants[0], resource.data.participants[1]))
        ) ||
        touchesOnlyOwnHiddenFlag()
      );

      // CLOSED (P0 / H-4). A client delete here removed the SHARED
      // document, and `onChatDeleted` then cascaded into every message
      // and every Storage object in the thread — including the other
      // participant's. One person's "Söhbəti sil" therefore destroyed
      // both people's history irreversibly, which in a harassment
      // scenario means the abuser deletes the evidence out of the
      // victim's own account. (The client's own `deleteChat` comment
      // acknowledged this as an MVP shortcut: "Delete for me only isn't
      // modeled yet".)
      //
      // `deleteChat` now writes `hiddenFor.{own uid}` instead (see the
      // update rule above), and the document is hard-deleted only once
      // BOTH participants have hidden it — by `hardDeleteFullyHiddenChat`
      // (functions/src/index.ts, Admin SDK, which bypasses this rule),
      // whose delete still triggers the same `onChatDeleted` cascade so
      // no messages or media are left orphaned.
      allow delete: if false;

      // Membership is checked by parsing chatId itself (rather than a
      // get() on the parent doc) because the chat doc and its first
      // message are created together in one transaction — a get() here
      // wouldn't see that sibling write and would wrongly deny it.
      match /messages/{messageId} {
        allow read: if request.auth != null && chatId.split('_').hasAny([request.auth.uid]);

        // NOTE: a `get()`-based defense-in-depth check (only allow into
        // an 'accepted' chat, or a not-yet-existing one) was tried here
        // and pulled back out — it broke sending the very first message
        // of a brand-new conversation in practice and wasn't worth the
        // risk. The actual pending/declined enforcement already happens
        // in FirebaseChatRepository's own transaction (`canSend`), which
        // runs before this write is ever attempted; membership is all
        // this rule needs to check.
        // `isActiveUser()` gate added (Düzəliş Prompt 11 / Y-1, Variant
        // B) — chat messaging is the highest-harm, highest-volume abuse
        // path for a banned/deleted account whose cached ID token is
        // still technically valid (up to ~1h): without this, a banned
        // user could keep harassing someone by message until the token
        // naturally expired. `revokeRefreshTokens` alone doesn't stop
        // this (Cloud Functions' `onCall` runtime and Firestore Rules
        // don't check token-revocation status by default) — this checks
        // live Firestore state instead, which is independent of the
        // token's own freshness.
        // `text` size cap (Düzəliş Prompt 8 / RT-2) — was completely
        // unbounded before; a multi-megabyte `text` value could cause
        // real OOM pressure on any device rendering the chat. 2000
        // characters is generous for a chat message and nowhere near
        // the size that would cause that. `text` is optional (media
        // messages carry none), hence the `!('text' in ...)` escape.
        // Düzəliş Prompt 5 (K-3) — blocked pair can never write a
        // message, even into an already-`accepted` chat (unlike the
        // create-time-only block/whoCanMessageMe check above, this one
        // re-checks on EVERY message, since a block can happen mid-
        // conversation — the most common real-world blocking scenario).
        //
        // RT-5 — EXPERIMENTAL, pending emulator verification against the
        // exact same-transaction chat+first-message write
        // (FirebaseChatRepository._sendMessage's runTransaction). A
        // near-identical get()-based check was tried here once before
        // and reverted (see the NOTE further up) for allegedly breaking
        // a brand-new chat's first message — that failure mode hasn't
        // been reproduced against this specific `exists()`-guarded
        // shape yet. If the dedicated test in firestore-prompt5.test.ts
        // fails, this ONE clause (declinedGuard) is removed and RT-5 is
        // deferred as a separate, documented finding — it must not
        // block the rest of this prompt.
        // `mediaUrl` shape check (P0 / C-1, DEFENCE IN DEPTH ONLY) — the
        // real fix lives in `functions/src/index.ts`
        // ([chatMediaPathForMessage]): server-side deletion no longer
        // reads this field at all, it recomputes the path from
        // (chatId, senderId, messageId, type). This clause exists purely
        // so the field can't hold an arbitrary attacker-chosen string in
        // the first place, and must NEVER be relied on as the boundary —
        // it constrains the URL's PREFIX, not the object path inside it,
        // so a value passing this check can still point anywhere in the
        // bucket. Optional: text/post messages carry no `mediaUrl` at
        // all, and a `post` message's `mediaUrl` legitimately points at
        // `posts/{uid}/...` rather than a chat folder, which is exactly
        // why a stricter path-level rule would break a real flow.
        allow create: if request.auth != null &&
          request.auth.uid == request.resource.data.senderId &&
          chatId.split('_').hasAny([request.auth.uid]) &&
          isActiveUser(request.auth.uid) &&
          (!('text' in request.resource.data) || request.resource.data.text.size() <= 2000) &&
          (!('mediaUrl' in request.resource.data) ||
           request.resource.data.mediaUrl.matches('https://firebasestorage[.]googleapis[.]com/.*')) &&
          !isBlockedPair(chatId.split('_')[0], chatId.split('_')[1]) &&
          (!exists(/databases/$(database)/documents/chats/$(chatId)) ||
           get(/databases/$(database)/documents/chats/$(chatId)).data.get('status', 'pending') != 'declined');
        // Update is used for the recipient marking deliveredAt/readAt,
        // and by either participant adding themselves to `deletedFor`
        // ("Özün üçün sil"). "Hər kəs üçün sil" is a real delete below,
        // sender-only — a recipient can hide a message for themselves
        // but never remove the sender's own copy of it.
        //
        // Field-restricted (Düzəliş Prompt 2 / K-2) — the client's own
        // write paths (FirebaseChatRepository) never touch anything but
        // these three fields on update; a bare "any participant" rule
        // previously let anyone rewrite `text`/`senderId`/`mediaUrl` on
        // any message after the fact. `deletedFor` may only ever GAIN
        // the caller's own uid — never another participant's, never a
        // removal (a self-delete can't be undone by re-adding then
        // stripping someone else's entry in the same write).
        // Fixed (post-launch QA) — `resource.data.deletedFor` used to be
        // read via bare dot access, which errors (denies) when the
        // field is simply absent, not just when the document is. Every
        // message `FirebaseChatRepository._sendMessage` creates has NO
        // `deletedFor` field at all (never initialized at create time —
        // see that method), so "özün üçün sil" on ANY untouched message
        // — sender's own or the other participant's — hit this exact
        // evaluation error instead of the intended permission check.
        // `.get('deletedFor', [])` treats a missing field as an empty
        // list, matching what the client's own model already assumes
        // (`deletedFor: (data['deletedFor'] as List?) ?? const []`).
        allow update: if request.auth != null && chatId.split('_').hasAny([request.auth.uid]) &&
          (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deliveredAt', 'readAt']) ||
            (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deletedFor']) &&
             request.resource.data.deletedFor.removeAll(resource.data.get('deletedFor', [])).hasOnly([request.auth.uid]) &&
             resource.data.get('deletedFor', []).removeAll(request.resource.data.deletedFor).size() == 0)
          );
        allow delete: if request.auth != null && request.auth.uid == resource.data.senderId;
      }
    }

    // Voice/video calls. Mirrors the `chats/{chatId}` pattern above —
    // the SDP offer/answer live directly on the call doc (small enough
    // for a normal write, and both sides need to read it exactly once
    // to establish the connection), while the trickle ICE candidates
    // each side discovers over the call's lifetime go in their own
    // subcollections so many small appends don't require rewriting the
    // whole doc.
    match /calls/{callId} {
      // Fixed (post-launch QA) — a call doc gets deleted at the end of
      // its lifecycle; a client whose snapshot listener is still
      // attached at that moment (or any late read of an ID from a
      // just-ended call) used to hit the same `resource == null`
      // evaluation error as a real access denial. `resource == null ||`
      // lets that read as a clean "not found" instead.
      allow read: if request.auth != null &&
        (resource == null || request.auth.uid in resource.data.participants);

      // `isActiveUser()` gate (Düzəliş Prompt 11 / Y-1, Variant B) —
      // same reasoning as `chats/{chatId}/messages` create above: calls
      // are the other high-harm harassment vector a banned account's
      // still-valid token could otherwise keep using.
      // Düzəliş Prompt 5 (K-3/RT-14) — before this, NEITHER the client
      // (`FirebaseCallRepository.startCall`) NOR the rules checked
      // blocking at all for calls; only the chat-based UI's own
      // "yalnız accepted çatda zəng düyməsi" gate discouraged it, which
      // a direct `startCall()` call trivially bypasses.
      allow create: if request.auth != null &&
        request.auth.uid == request.resource.data.callerId &&
        request.auth.uid in request.resource.data.participants &&
        request.resource.data.status == 'ringing' &&
        isActiveUser(request.auth.uid) &&
        !isBlockedPair(request.resource.data.callerId, request.resource.data.receiverId);

      // Callee accepting/declining (status only), either side ending
      // the call, or the caller attaching its SDP offer / callee
      // attaching its SDP answer — never a reassignment of who's on
      // the call.
      allow update: if request.auth != null &&
        request.auth.uid in resource.data.participants &&
        request.resource.data.participants == resource.data.participants &&
        request.resource.data.callerId == resource.data.callerId;

      allow delete: if false;

      match /offerCandidates/{candidateId} {
        allow read: if request.auth != null &&
          request.auth.uid in get(/databases/$(database)/documents/calls/$(callId)).data.participants;
        allow create: if request.auth != null &&
          request.auth.uid == get(/databases/$(database)/documents/calls/$(callId)).data.callerId;
        allow update, delete: if false;
      }

      match /answerCandidates/{candidateId} {
        allow read: if request.auth != null &&
          request.auth.uid in get(/databases/$(database)/documents/calls/$(callId)).data.participants;
        allow create: if request.auth != null &&
          request.auth.uid != get(/databases/$(database)/documents/calls/$(callId)).data.callerId &&
          request.auth.uid in get(/databases/$(database)/documents/calls/$(callId)).data.participants;
        allow update, delete: if false;
      }
    }

    // Self-service-submitted local businesses (Kəşf et → Məkanlar).
    // Auto-id'd docs; any signed-in user can read (discovery is open to
    // everyone, and visibility is a pure client-side geohash/radius
    // query — not gated by any per-viewer rule here, `status` does
    // that filtering in the query itself). Only the submitting owner
    // can write, and only to non-moderation fields — see below.
    match /venues/{venueId} {
      allow read: if request.auth != null;

      // Create is Cloud-Function-only (`submitVenue`, functions/src/
      // index.ts, Admin SDK — bypasses this rule entirely) — same
      // reasoning as `offers/{offerId}` below: the venue doc and its
      // first `payments` doc must be created together, and only
      // `submitVenue` can guarantee that pairing (a raw client write
      // could create a venue with no real payment behind it at all,
      // which is exactly the bug this migration fixed — see
      // `FirebaseVenueRepository.createVenue`'s own doc comment).
      allow create: if false;

      // `ownerId` is immutable — an update can't reassign a venue to a
      // different owner, even the current owner's own write. `likeCount`/
      // `rating` are grant-of-trust denormalized fields (same reasoning
      // as `premium` on `users/{userId}`) — blocked here even for the
      // owner's own write, since only the `onVenueLikeCreated`/
      // `onVenueLikeDeleted` Cloud Function triggers (functions/src/
      // index.ts) may set them, deriving `rating` from `likeCount` so
      // the two can never be faked independently of real `likes` docs.
      // `status`/`reviewNote`/`reviewedBy`/`reviewedAt` are the same
      // kind of grant-of-trust field — only the admin panel's Server
      // Actions (Admin SDK, which bypasses these rules) may set them;
      // an owner editing their own venue (name/photo/hours/etc.) can
      // never touch its moderation state, including moving it back to
      // 'pending' themselves — that's `resubmitVenue` (Cloud Function,
      // functions/src/index.ts)'s job, gated on `needs_revision` OR
      // `approved` (editing an already-live venue re-enters moderation
      // too, so a swapped-in photo/description can't go live unreviewed).
      // `lastPeakNotifiedAt` is the same kind of grant-of-trust field —
      // only `computeVenueAudienceHistory` (scheduled Cloud Function,
      // functions/src/index.ts) sets it, so the owner can't reset their
      // own cooldown to spam themselves peak-hour pushes. `paymentId`/
      // `revisionDeadline` are the same again — `paymentId` is fixed at
      // creation (the client can't repoint a venue at a different
      // payment), and `revisionDeadline` is set/cleared only by the
      // admin panel and `resubmitVenue`/`expireVenueRevisionDeadlines`
      // (functions/src/index.ts), so the owner can't grant themselves
      // extra time to fix a flagged listing. `subscriptionRenewsAt` is
      // the same again — only `applyPaymentOutcome` (first payment and
      // every renewal), `renewVenueSubscriptions` (the scheduled sweep
      // that invoices an overdue cycle), and `assignFoundingVenueIfEligible`
      // (the founding "1 ay hədiyyə" extension) may push it forward, so
      // the owner can't grant themselves a free extra cycle by editing
      // their own venue.
      // `isFoundingVenue`/`freeOffersUsed`/`freeOfferWindowEnd` are the
      // same again — only `assignFoundingVenueIfEligible` (on first
      // approval) and `submitOffer`'s free-quota transaction (both
      // functions/src/index.ts) may touch these, so an owner can't
      // self-grant founding status or reset their own free-offer count.
      // `ratingAverage`/`ratingCount` join that same grant-of-trust
      // list — only `onReviewWritten` (functions/src/index.ts) may set
      // them, recomputed from `reviews` on every write, same reasoning
      // as `likeCount`/`rating` above but for the separate review-based
      // score. `isPremium`/`premiumSince`/`premiumExpiresAt`/
      // `premiumExpiryReminderSent` are the same again — only
      // `applyPaymentOutcome`'s `venue_premium` branch (a real Epoint
      // charge), `expireVenuePremium` (the scheduled expiry/reminder
      // sweep), and the admin panel's manual toggle (Admin SDK, bypasses
      // these rules) may set them, so an owner can't self-grant premium
      // status or extend their own expiry by editing their own venue.
      // `name`/`category`/`lat`/`lng`/`position`/`address`/`country`/
      // `openingHours`/`socialLinks`/`audienceRadiusMode`/
      // `audienceRadiusKm`/`birthdayNotificationsEnabled`/`photoUrl` are
      // blocked too — every real field edit now goes through the
      // `updateVenue` Cloud Function (functions/src/index.ts), which
      // diffs old vs. new server-side and decides whether the edit needs
      // to re-enter moderation (everything does, except a radius-only
      // change). Blocking these here is what actually makes that
      // decision tamper-proof — without it, a client could still write
      // any of these fields directly and simply never call the function
      // that would otherwise send the venue back for review. The two
      // remaining legitimate owner-direct-write flows are
      // `availableSeats`/`seatsUpdatedAt` (the standalone seat-count
      // sheet) and `firstPaymentAnnouncementPending` (dismissing the
      // one-time payment-confirmed card) — neither touches moderation-
      // relevant content, so neither needs to go through the function.
      // `offerAcceptedVersion`/`offerAcceptedAt`/`offerAcceptedFrom`/
      // `offerDocumentUrl` are the same grant-of-trust shape as
      // `paymentId`/`subscriptionRenewsAt` above — only
      // `applyPaymentOutcome`'s `venue_subscription` branch (Admin SDK)
      // may set them, once a real Epoint charge attached to a fresh
      // "Biznes Xidmətlərinin Publik Ofertası" acceptance actually
      // succeeds (see `submitVenue`/`retryVenueSubscriptionPayment`'s
      // `offerAcceptance` payload) — an owner can't self-grant
      // acceptance of a version they never actually agreed to.
      // `verified`/`gallery` join the lock too (Düzəliş Prompt 2 / C#61)
      // — neither is written by any client code today (confirmed by
      // grep: `verified` has no write path at all, `gallery` has no
      // upload feature built yet), but both sat outside this blocklist,
      // so a direct/modified-client write could still set either. No
      // legitimate flow loses anything by closing this.
      // `nameLower` joins the lock (P0, class-search finding C-d) —
      // `name` was already locked but its lowercase search key was not,
      // and `searchVenues` matches on `nameLower`, never on `name`. An
      // owner could therefore leave the moderated display name intact
      // while making the venue surface under entirely different search
      // terms. `submitVenue`/`updateVenue` both derive it from `name`
      // (`name.toLowerCase()`), so nothing legitimate writes it alone.
      // `activeCheckinCount` (Düzəliş Prompt 4, K-4) joins the lock too
      // — only `onActiveCheckinCreated`/`onActiveCheckinDeleted`
      // (functions/src/index.ts) may set it, derived from real
      // `activeCheckins` docs, so an owner can't inflate their own
      // "hazırda N nəfər" counter by editing their own venue directly.
      //
      // `visibleCheckinCount`/`currentAudienceCount`/
      // `audienceCountUpdatedAt` are the same rule, and their absence
      // here was a REGRESSION rather than an omission. When the two
      // occupancy counts were separated (docs/VENUE_OCCUPANCY.md), the
      // numbers moved to new fields and the lock did not move with
      // them — it kept naming `activeCheckinCount`, which by then was
      // the DEPRECATED field nothing writes any more (BACKLOG #24
      // keeps it only for builds still in the store). So the protected
      // field was the dead one and the two live ones were open.
      // Emulator-confirmed: the owner could write both.
      //
      // What that allowed: `currentAudienceCount` is the Canlı tab's
      // "N nəfər ətrafda" card and ticker, `visibleCheckinCount` is the
      // profile's "Hazırda N PeakPin istifadəçisi buradadır" — an owner
      // could put any number in front of every user in radius.
      // `audienceCountUpdatedAt` belongs in the lock for a second
      // reason: the client refuses to draw a figure older than 20
      // minutes, so an owner able to restamp it could keep a fabricated
      // count on screen indefinitely.
      //
      // Only `computeVenueAudienceHistory` and `bumpActiveCheckinCount`
      // write these, both applying the k-anonymity floor first. The
      // pair is written in ONE transaction with the raw counter in
      // `venues/{id}/private/counters`, which no client can read at
      // all — this lock is what keeps the public mirror as trustworthy
      // as the private truth.
      //
      // WHEN THE COUNTER FIELDS CHANGE NAME AGAIN, CHANGE THIS LIST IN
      // THE SAME COMMIT. `tests/rules/firestore-checkin.test.ts` now
      // asserts all three, which is the thing that would have caught
      // this one.
      allow update: if request.auth != null &&
        request.auth.uid == resource.data.ownerId &&
        request.resource.data.ownerId == resource.data.ownerId &&
        !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['likeCount', 'rating', 'ratingAverage', 'ratingCount', 'status', 'reviewNote', 'reviewedBy', 'reviewedAt', 'lastPeakNotifiedAt', 'paymentId', 'revisionDeadline', 'subscriptionRenewsAt', 'isFoundingVenue', 'freeOffersUsed', 'freeOfferWindowEnd', 'isPremium', 'premiumSince', 'premiumExpiresAt', 'premiumExpiryReminderSent', 'name', 'category', 'lat', 'lng', 'position', 'address', 'country', 'openingHours', 'socialLinks', 'audienceRadiusMode', 'audienceRadiusKm', 'birthdayNotificationsEnabled', 'photoUrl', 'offerAcceptedVersion', 'offerAcceptedAt', 'offerAcceptedFrom', 'offerDocumentUrl', 'verified', 'gallery', 'activeCheckinCount', 'visibleCheckinCount', 'currentAudienceCount', 'audienceCountUpdatedAt', 'nameLower']);

      allow delete: if request.auth != null && request.auth.uid == resource.data.ownerId;
    }

    // Verified Reviews (Faza 1) — a review can only exist backed by a
    // real, staff-confirmed visit (a `seated` waitlist entry), which
    // is exactly what makes this different from a normal open review
    // system. `reviewId` is always `{venueId}_{userId}` (same composite
    // -key convention as `follows/{viewerId}_{ownerId}` above) — that,
    // not a rule searching for duplicates, is what makes "one review
    // per user per venue" structural: a second attempt just overwrites
    // the first doc.
    match /reviews/{reviewId} {
      // Only the categories that have the waitlist feature — a review
      // can only exist behind a `seated` waitlist entry, so the two
      // sets cannot differ without one of them being pointless.
      //
      // This is the SAME list as `WAITLIST_ELIGIBLE_CATEGORIES`
      // (functions/src/venue-categories.ts) and
      // `kWaitlistEligibleVenueCategories` (venue.dart), and
      // `tests/rules/venue-categories.test.ts` asserts that it is. It
      // used to be described as a copy of
      // `config/waitlistCategories.enabledCategories` — a Firestore
      // document that turned out to be read by the client and by
      // nothing else, which is why the lists moved into code.
      function isEligibleCategory(venueId) {
        return get(/databases/$(database)/documents/venues/$(venueId)).data.category in
          ['restaurant', 'pub', 'fastFood', 'coffeeShop', 'teaHouse', 'karaoke', 'sweetsShop', 'gameHall', 'spa', 'carWash'];
      }

      // The actual "real visit" proof — a `get()`, not a query:
      // Firestore rules can only inspect one already-known document
      // path, never search, which is exactly why the client has to
      // supply the entry id up front rather than the rule finding it.
      function hasVerifiedVisit(venueId, waitlistEntryId, uid) {
        let entry = get(/databases/$(database)/documents/venues/$(venueId)/waitlist/$(waitlistEntryId)).data;
        return entry.status == 'seated' && entry.userId == uid;
      }

      function isValidRatingAndComment() {
        return request.resource.data.rating is int &&
          request.resource.data.rating >= 1 && request.resource.data.rating <= 5 &&
          request.resource.data.comment is string &&
          request.resource.data.comment.size() <= 500;
      }

      // Was fully public (`if true`), then narrowed to any-signed-in-user
      // (Düzəliş Prompt 2 / INFRA-8) — which fixed the wrong axis. The
      // problem was never authentication, it was ENUMERATION: `read`
      // grants `list` too, so any signed-in account could pull the whole
      // collection, and a review here is not ordinary content. It can
      // only exist behind `hasVerifiedVisit` (a waitlist entry the
      // venue's own staff marked `seated`), so its existence proves a
      // specific person was physically inside a specific venue — and the
      // document id is `{venueId}_{userId}`. One query returned the
      // entire "who was where" graph, i.e. exactly the exposure Düzəliş
      // Prompt 4 removed from the location feed, via a different route.
      //
      // `get` stays open — reading one already-known review id
      // (`watchMyReview`, a plain `.doc()` read) is not enumeration.
      // Same `get`-vs-`list` split as `usernames`.
      //
      // The venue profile's review list now comes from the
      // `listVenueReviews` callable (functions/src/index.ts), which also
      // applies a bidirectional block filter and a result cap that a raw
      // client query never could.
      allow get: if request.auth != null;
      allow list: if false;

      // `isActiveUser()` (self-verification / d4). Reviews are the one
      // piece of permanent, public reputation content a banned account
      // could still produce: unlike posts/venues/pinboxes there is no
      // moderation queue behind them — nothing looks at a review until
      // somebody reports it. `hasVerifiedVisit()` below narrows this
      // (a banned user can no longer manufacture a fresh visit) but
      // does not close it, since an old seated waitlist entry stays
      // valid forever.
      allow create: if request.auth != null &&
        isActiveUser(request.auth.uid) &&
        reviewId == request.resource.data.venueId + '_' + request.auth.uid &&
        request.auth.uid == request.resource.data.userId &&
        request.resource.data.keys().hasOnly(['venueId', 'userId', 'rating', 'comment', 'waitlistEntryId', 'createdAt', 'updatedAt']) &&
        isValidRatingAndComment() &&
        hasVerifiedVisit(request.resource.data.venueId, request.resource.data.waitlistEntryId, request.auth.uid) &&
        isEligibleCategory(request.resource.data.venueId);

      // Two disjoint paths: the review's own author re-proving the
      // same waitlist condition as create (editing after a later
      // visit), or the venue's owner setting their one-time public
      // reply — see `Review.ownerReply`'s doc comment (Dart) for why
      // it's a single shot, never editable after.
      allow update: if request.auth != null &&
        (
          (request.auth.uid == resource.data.userId &&
            request.resource.data.venueId == resource.data.venueId &&
            request.resource.data.userId == resource.data.userId &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rating', 'comment', 'waitlistEntryId', 'updatedAt']) &&
            isValidRatingAndComment() &&
            hasVerifiedVisit(resource.data.venueId, request.resource.data.waitlistEntryId, request.auth.uid) &&
            isEligibleCategory(resource.data.venueId)) ||
          (request.auth.uid == get(/databases/$(database)/documents/venues/$(resource.data.venueId)).data.ownerId &&
            // A freshly-created review never had `ownerReply` in its key
            // list (see the `create` rule's `hasOnly` above) — the field
            // is genuinely ABSENT, not present-and-null, and Firestore
            // Rules throws on `resource.data.ownerReply` when the key
            // doesn't exist at all. `in` is the safe existence check.
            !('ownerReply' in resource.data) &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ownerReply', 'updatedAt']))
        );

      // Only the admin panel (Admin SDK, bypasses this) deletes a
      // review — via a resolved `reviewReports` entry. Neither the
      // author nor the venue owner can remove one directly.
      allow delete: if false;
    }

    // Top-level, separate from the (unrelated, still-unused) VIP-purchase
    // `users/{userId}/payments` subcollection above — this one backs the
    // venue/offer/PinBox-order/boost fee-refund state machine (see
    // `Venue.paymentId`/`Offer.paymentId`, `listingType`/`listingId`
    // distinguishing which, `functions/src/index.ts`'s
    // `processPaymentRefund`/`expireListingRevisionDeadlines`). Every
    // real payment now goes through Epoint — created `status: 'pending'`
    // server-side (`submitVenue`/`submitOffer`/`reservePinBoxOrder`/
    // `createBoostCheckout`/`ensurePendingSubscriptionPayment`, all
    // Admin SDK, bypass this rule) and flipped to `'completed'`/`'failed'`
    // only by `applyPaymentOutcome` on a confirmed Epoint webhook — so no
    // client write path exists or should exist. (Older venue/offer
    // payment docs from before this migration may still show
    // `status: 'completed'` written directly by the client — see
    // `FirebaseVenueRepository.createVenue`'s own doc comment for that
    // history; this rule no longer permits writing NEW ones that way.)
    match /payments/{paymentId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.ownerId;
      allow write: if false;
    }

    // "Kartlarım" — a saved Epoint card. Same shape/reasoning as
    // `payments/{paymentId}` right above: only `startCardRegistration`/
    // `epointWebhook`'s `applyCardRegistrationOutcome`/`deleteSavedCard`/
    // `setDefaultSavedCard` (all Admin SDK) ever write here.
    //
    // Fixed (post-launch QA) — unlike `payments`, a saved card CAN be
    // deleted (`deleteSavedCard`) while the client's own "Kartlarım"
    // screen still holds a listener on that exact doc; without
    // `resource == null ||` that delete turned into a permission-denied
    // instead of a clean "this card is gone" read.
    match /savedCards/{cardId} {
      allow read: if request.auth != null &&
        (resource == null || request.auth.uid == resource.data.ownerId);
      allow write: if false;
    }

    // Maps an Apple `originalTransactionId`/Google purchase token back
    // to the uid that purchased it — purely internal bookkeeping so
    // `appStoreServerNotifications`/`googlePlayRtdn` (functions/src/
    // index.ts) know whose `premium` to update on a renewal/
    // cancellation notification, which arrives with no uid of its own.
    // No client read/write path exists or should exist.
    match /iapSubscriptions/{transactionKey} {
      allow read, write: if false;
    }

    // "Kimlik doğrulama" (ID + selfie -> blue-check review), separate
    // from `users/{userId}.identityVerified` itself (already
    // grant-of-trust locked above) and from the OLD phone-OTP
    // `isVerified` step this has nothing to do with. Deliberately
    // `allow write: if false` in full, including create — unlike every
    // other owner-submitted collection in this file (venues, offers,
    // payments), a raw client write can't enforce "at most one active
    // pending request per user" (that needs a query, not a single-doc
    // rule check), so submission goes through `submitIdentityVerification`
    // (Cloud Function, Admin SDK) instead, which enforces it in code.
    // `idFrontPath`/`idBackPath`/`selfieWithIdPath` are Storage PATHS,
    // never download URLs — see storage.rules' identity_verifications/
    // block for why a URL would leak the image regardless of rules.
    match /identityVerifications/{requestId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.userId;
      allow write: if false;
    }

    // Faza 5 (bildiriş sistemi tamamlanması) — admin panelin "Bell"
    // xəbərdarlıq siyahısı. No mobile-app user, admin or otherwise,
    // ever needs to read this via the client SDK: the admin panel is
    // entirely server-rendered (Server Components/Actions, Admin SDK,
    // bypasses these rules) — see its `src/lib/data/
    // admin-notifications.ts`. Written only by Cloud Functions.
    match /adminNotifications/{notificationId} {
      allow read, write: if false;
    }

    // A user's like on a venue — existence alone is the "like", no
    // fields to validate. `likeCount`/`rating` on the parent venue doc
    // are derived from this collection's size by Cloud Function
    // triggers, never written directly (see venues/{venueId} above).
    match /venues/{venueId}/likes/{userId} {
      allow read: if request.auth != null;
      // `exists()` on create only — a like must attach to a real venue,
      // otherwise `onVenueLikeCreated` bumps a counter on a document
      // that isn't there and the like doc itself is orphaned (the venue
      // is already gone, so `deleteUserVenues` can never sweep it).
      // Delete stays unconditional: removing a like from a
      // since-deleted venue must not be blocked.
      allow create: if request.auth != null && request.auth.uid == userId &&
        exists(/databases/$(database)/documents/venues/$(venueId));
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // "İzlə" — venue-level follow (deliberately separate from the
    // user-to-user `follows` collection; see
    // `VenueFollowRepository`'s own doc comment). `userId` is
    // denormalized onto the doc so the app's `collectionGroup
    // ('followers').where('userId', '==', uid)` reverse lookup ("which
    // venues do I follow") can be evaluated per-doc against this same
    // rule. Only the venue owner may additionally read the full list
    // (a follower count use case, not built yet but harmless to allow
    // now); never updated once created.
    match /venues/{venueId}/followers/{userId} {
      allow read: if request.auth != null && (
        request.auth.uid == userId ||
        request.auth.uid == get(/databases/$(database)/documents/venues/$(venueId)).data.ownerId
      );
      allow create: if request.auth != null &&
        request.auth.uid == userId &&
        request.resource.data.userId == userId;
      allow update: if false;
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // Written exclusively by `computeVenueAudienceHistory` (scheduled
    // Cloud Function, Admin SDK — bypasses these rules entirely) every
    // 15 minutes; no client write path exists or should exist, since
    // these counts are what the peak-hour detector trusts. Read is
    // open the same way every other `venues/**` doc is (see
    // `venues/{venueId}` above) — a future owner-facing analytics view
    // could read a venue's own history without a rules change, and the
    // data itself is just aggregate counts, never individual profiles.
    match /venues/{venueId}/audienceHistory/{entryId} {
      // CLOSED (Audit 3 / A3-M2). Was `if request.auth != null`, which
      // meant any signed-in account could list every venue's raw
      // 15-minute presence counts for the last 7 days — including the
      // 1s and 2s that `previewVenueAudience` refuses to report,
      // because its k-anonymity floor never applied here. The rule's
      // own comment justified the openness with "a future owner-facing
      // analytics view could read this without a rules change": a
      // permission granted ahead of a feature that does not exist.
      //
      // Nothing needs it now. The Canlı tab reads
      // `venues/{id}.currentAudienceCount` — already floored, written
      // by `computeVenueAudienceHistory` — and the raw series stays
      // server-side where the peak-hour detector uses it.
      allow read: if false;
      allow write: if false;
    }

    // Walk-in waitlist entry. Readable by the entry's own user AND the
    // venue's owner (a `get()` on the fixed parent venue doc — not a
    // per-document-varying lookup, so this doesn't hit the list-query
    // cross-document caveat that ruled out an equivalent approach for
    // story visibility). `queuePosition` is never client-writable in
    // either create or update — only `maintainWaitlistQueuePositions`
    // (Cloud Function, functions/src/index.ts) sets it, so two people
    // joining at once can't race into the same number.
    match /venues/{venueId}/waitlist/{entryId} {
      function isVenueOwner() {
        return get(/databases/$(database)/documents/venues/$(venueId)).data.ownerId == request.auth.uid;
      }

      allow read: if request.auth != null &&
        (resource.data.userId == request.auth.uid || isVenueOwner());

      // A rule here could validate this NEW document's own shape, but
      // never "does this phone number already have a `waiting` entry
      // at this venue" — that needs a read of OTHER documents at
      // commit time, which only a transaction can do atomically. So
      // creation moved server-side entirely: `joinWaitlist` (Cloud
      // Function, functions/src/index.ts) is now the only path, using
      // the Admin SDK, which bypasses this rule.
      allow create: if false;

      // Either the entry's own user cancelling their still-waiting
      // spot, or the venue owner driving the rest of the lifecycle
      // (call/seat/no-show/remove) — `partySize`/`userId`/`joinedAt`
      // are immutable either way.
      allow update: if request.auth != null &&
        request.resource.data.userId == resource.data.userId &&
        request.resource.data.partySize == resource.data.partySize &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['queuePosition']) &&
        (
          (request.auth.uid == resource.data.userId &&
            resource.data.status == 'waiting' &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']) &&
            request.resource.data.status == 'cancelled') ||
          (isVenueOwner() &&
            // The owner may only move an entry that is still LIVE.
            //
            // Without this the owner branch constrained the destination
            // status but not the origin, so a `cancelled`, `noShow` or
            // `seated` entry could be set back to `called` — and
            // `maintainWaitlistQueuePositions` fires `waitlistCalled`
            // on any `!= called` → `called` transition. The result was
            // a "Sıra sizindir! — 5 dəqiqəyə gəlin" push to someone who
            // had already cancelled and gone home.
            //
            // This became worth fixing rather than tolerating when
            // `waitlistCalled` moved to the ungated `account` category
            // (see functions/src/notification-categories.ts): the
            // recipient used to be able to escape it by switching off
            // "Məkan yenilikləri", and now cannot. Making a message
            // unsilenceable and leaving a path that sends it wrongly is
            // the half-fix that turns a good change into a worse one.
            //
            // `['waiting', 'called']` is EXACTLY what the owner's
            // screen can reach: `VenueWaitlistScreen` queries
            // `whereIn: [waiting, called]`, so a terminal entry is not
            // even rendered — waiting rows offer Çağır/Sil, called rows
            // offer Oturdu/Gəlmədi. Nothing legitimate is lost.
            //
            // DELIBERATELY NOT ADDING `noShow` → `waiting`. A venue
            // marking someone no-show by mistake while they are still
            // standing there is a real scenario, but there is no screen
            // that could undo it — the entry vanishes from the only
            // list the owner has. Granting the permission now would be
            // a permission ahead of its feature, the same mistake this
            // file made with `audienceHistory`. If that undo is ever
            // built it needs its own decision, and specifically a way
            // to restore the entry WITHOUT re-firing `waitlistCalled`
            // (re-calling the person afterwards should notify; silently
            // reinstating them should not).
            //
            // A `called` → `called` re-write stays allowed and is
            // harmless: the trigger trips only on a change INTO
            // `called`, so it cannot double-send.
            resource.data.status in ['waiting', 'called'] &&
            // `seatedAt` — stamped alongside `status: seated` by the
            // same `markSeated` write (see `firebase_waitlist_
            // repository.dart`), the review system's proof of visit.
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'calledAt', 'seatedAt']))
        );

      allow delete: if false;
    }

    // A user's active check-in at this venue — existence alone means
    // "here right now". `update` is allowed alongside create/delete
    // only as a defensive no-op path (the app never actually updates
    // this doc in place, only creates/deletes it) — still owner-only
    // either way, so it grants nothing extra.
    //
    // Read narrowed to the checked-in user + the venue's own owner
    // (Düzəliş Prompt 4 / K-4) — was `if request.auth != null` (ANY
    // signed-in user could enumerate exactly who is physically present
    // at a venue right now). The live "Hazırda N istifadəçi buradadır"
    // count and the live-feed "audience" item now read
    // `venues/{venueId}.activeCheckinCount` instead (a plain int,
    // maintained by `onActiveCheckinCreated`/`onActiveCheckinDeleted`,
    // functions/src/index.ts) — neither ever needed raw per-user
    // check-in identity, only a number, so this doesn't break them
    // (both call sites — `watchActiveCheckinCount` and
    // `LiveFeedService.fetchAudienceItems` — were updated to match). No
    // other client read site for this subcollection was found.
    // Server-only counters for a venue. Holds the RAW
    // `activeCheckinCount`; the venue document carries only
    // `visibleCheckinCount`, the same number with the k-anonymity
    // floor applied. Closed to everyone, the venue's owner included —
    // see `bumpActiveCheckinCount` (functions/src/index.ts) for why
    // the raw figure must not live on a document any signed-in user
    // can read.
    match /venues/{venueId}/private/{document} {
      allow read, write: if false;
    }

    match /venues/{venueId}/activeCheckins/{userId} {
      // OWN DOCUMENT ONLY — the venue owner cannot read this either.
      //
      // The raw list is a list of PEOPLE currently at a place. A count
      // is a statistic; the list is surveillance, and it is not
      // something a user consents to by tapping "buradayam" for a
      // counter. The owner has no business case for the names that the
      // aggregate does not already serve: `activeCheckinCount` on the
      // venue doc is what every screen actually renders, including the
      // owner's own.
      //
      // Nothing read the list anyway — checked before closing it.
      // `watchActiveCheckinCount` reads the aggregate off the venue
      // doc, `watchIsCheckedInHere` reads only the caller's own
      // document, and the admin panel never touches this
      // subcollection. Previously owner-readable (Düzəliş Prompt 4 /
      // K-4 narrowed it from "any signed-in user" to "owner + the
      // checked-in user"); this finishes that narrowing.
      allow read: if request.auth != null && request.auth.uid == userId;
      // `isActiveUser()` on create (self-verification / d4).
      //
      // NOTE, corrected 2026-08-31: an earlier version of this comment
      // said a check-in "feeds `audienceHistory` and the peak-hour
      // notifications". It does not. `audienceHistory` and the
      // peak-hour signal come from `computeVenueAudienceHistory`,
      // which counts nearby USERS by `lastSeen`/`online` and position —
      // no check-in involved. The two are separate mechanisms and that
      // comment was itself an instance of the confusion. What a banned
      // account writing here actually poisons is
      // `venues/{id}.activeCheckinCount`, and through it the
      // "Ətrafınızda" line on the Canlı tab. Affordable because checking
      // in is a deliberate, occasional act — the client writes once on
      // arrival and deletes on departure, with no heartbeat in between
      // (`FirebaseVenueRemoteDatasource.checkIn`/`checkOut`), so the
      // `update` verb below is not actually exercised today.
      allow create: if request.auth != null && request.auth.uid == userId &&
        isActiveUser(request.auth.uid);
      // Departure must never be blocked: a user banned WHILE checked in
      // still has to be able to remove themselves, and the trigger that
      // maintains the venue's live count depends on that delete
      // arriving.
      allow update, delete: if request.auth != null && request.auth.uid == userId;
    }

    // Audit trail proving which version of the "PeakPin Biznes
    // Xidmətlərinin Publik Ofertası" this venue's owner accepted and
    // when — one doc per acceptance (first payment, plus any later
    // re-acceptance after a version bump), never overwritten. Same
    // `write: if false` shape as `payments/{paymentId}` below — only
    // `applyPaymentOutcome` (Admin SDK) may create these, exclusively
    // on a confirmed charge, so this can't be faked client-side.
    match /venues/{venueId}/offerAcceptances/{acceptanceId} {
      allow read: if request.auth != null &&
        request.auth.uid == get(/databases/$(database)/documents/venues/$(venueId)).data.ownerId;
      allow write: if false;
    }

    // Venue owner-submitted promotions (Kəşf et → Təkliflər). Same
    // open-read/owner-write shape as venues above — discovery is open
    // to everyone, only the submitting owner can create/update/delete.
    // No denormalized `favoriteCount` on this doc (unlike venues), so
    // update stays owner-only with no non-owner counter-bump exception
    // — but the same moderation-field lockdown as venues applies.
    match /offers/{offerId} {
      allow read: if request.auth != null;

      // Create is Cloud-Function-only (`submitOffer`, functions/src/
      // index.ts, Admin SDK — bypasses this rule entirely) — the
      // founding-venue free-quota decrement it does is a
      // read-check-then-write across the offer AND its venue doc, which
      // needs a real transaction to stay race-safe across two
      // near-simultaneous submissions; a rules-only check here couldn't
      // guarantee that the same way. `submitOffer` also derives
      // `category`/`venueName`/etc. from the venue doc itself rather
      // than trusting whatever the client sent.
      allow create: if false;

      // `ownerId` is immutable, same reasoning as venues. `status`/
      // `reviewNote`/`reviewedBy`/`reviewedAt` are admin-panel-only —
      // same reasoning as venues' update rule; `resubmitOffer` (Cloud
      // Function) is the only path back to 'pending'. `paymentId`/
      // `revisionDeadline` are the same grant-of-trust pairing as
      // `Venue.paymentId`/`revisionDeadline` — see that rule's comment.
      // `happyHourActive` is server-computed only (see the create rule
      // above and `maintainHappyHourActiveFlag`/`refreshHappyHourOfferStatus`
      // in functions/src/index.ts) — a client write here could show a
      // Happy Hour discount as active outside its real window.
      // `boostedUntil` is the same again — only `epointWebhook` sets it,
      // and only after a confirmed `boost_fee` charge (`createBoostCheckout`,
      // functions/src/index.ts); a client write here would be a free,
      // unpaid boost.
      // `title`/`description`/`offerType`/`discountValue`/`startDate`/
      // `endDate`/`terms`/`activeHours`/`activeDays`/`imageUrl`/
      // `category` join the lock (Düzəliş Prompt 6 / INFRA-5) — every
      // real content edit now goes through the `updateOffer` Cloud
      // Function (functions/src/index.ts), which diffs old vs. new
      // server-side and decides whether the edit needs to re-enter
      // moderation, same reasoning as `venues/{venueId}`'s own content
      // lock right above. Before this, these fields sat OUTSIDE the
      // blocklist entirely — a modified client could silently swap in
      // different content on an already-`approved` offer and simply
      // never call `resubmitOffer`, shipping unreviewed content live.
      // `description`/`terms` size caps (Düzəliş Prompt 8 / RT-2) kept
      // as defense-in-depth even though `updateOffer` is now the only
      // real path here — match the client's own existing
      // `maxLength: 200` on both fields (create_offer_screen.dart).
      allow update: if request.auth != null &&
        request.auth.uid == resource.data.ownerId &&
        request.resource.data.ownerId == resource.data.ownerId &&
        !request.resource.data.diff(resource.data).affectedKeys()
          // `venueId`/`venueName`/`venuePhotoUrl`/`lat`/`lng`/`position`/
          // `address`/`country`/`targetUserIds`/`personalMessage`/
          // `birthdayMatchId` joined the lock (P0, class-search finding
          // C-b). Düzəliş Prompt 6 / INFRA-5 added every CONTENT field
          // here but stopped there, leaving the offer's IDENTITY and
          // LOCATION open: an owner could take an already-`approved`
          // offer and repoint `venueId` at somebody else's venue (the
          // sibling `pinboxes` rule locks exactly this field, which is
          // what made the omission visible), or rewrite `lat`/`lng`/
          // `position` to teleport a moderated listing anywhere on the
          // map — discovery is a geohash query over `position`, so that
          // is a full relocation, invisible to the moderation queue
          // because `updateOffer`'s content diff never looks at these.
          // `submitOffer` derives all of them from the venue document
          // itself, so no legitimate flow writes them again.
          .hasAny(['status', 'reviewNote', 'reviewedBy', 'reviewedAt', 'paymentId', 'revisionDeadline', 'happyHourActive', 'boostedUntil', 'title', 'description', 'offerType', 'discountValue', 'startDate', 'endDate', 'terms', 'activeHours', 'activeDays', 'imageUrl', 'category', 'venueId', 'venueName', 'venuePhotoUrl', 'lat', 'lng', 'position', 'address', 'country', 'targetUserIds', 'personalMessage', 'birthdayMatchId']) &&
        (!('description' in request.resource.data) || request.resource.data.description.size() <= 200) &&
        (!('terms' in request.resource.data) || request.resource.data.terms.size() <= 200);

      allow delete: if request.auth != null && request.auth.uid == resource.data.ownerId;
    }

    // A user's one-time activation of an `OfferType.firstVisit` offer
    // (the "Aktivləşdir" button) — existence alone is the redemption,
    // same shape as venues/{venueId}/likes above. Only `create` is
    // granted (never `update`/`delete`): Firestore's own create-vs-
    // update distinction (a `create` request fails if the doc already
    // exists) is what actually enforces "once per user", not
    // client-side UI state.
    // A birthday offer's raw recipient list — the uids
    // `computeBirthdayMatches` found. Closed to everyone, exactly like
    // `venues/{id}/private/counters`: the number of people with a
    // birthday today is a statistic, the list of them is a disclosure
    // of a `private/data` field. Only `submitOffer` writes it (Admin
    // SDK, in the same transaction as the offer) and only
    // `notifyBirthdayTargetUsers` reads it. Clients get their own
    // `users/{uid}/birthdayOffers/{offerId}` marker instead.
    match /offers/{offerId}/private/{document} {
      allow read, write: if false;
    }

    match /offers/{offerId}/redemptions/{userId} {
      allow read: if request.auth != null;
      // The offer must still exist and still be live. Previously this
      // checked only "is this your own uid", so a redemption could be
      // recorded against an offer that had been rejected, sent back for
      // revision, or whose venue owner had deleted their account — the
      // user would see a successful activation for something the venue
      // can no longer honour. Same class as `reservePinBoxOrder`
      // accepting money for a PinBox whose venue was gone
      // (functions/src/index.ts), found in the same sweep.
      allow create: if request.auth != null && request.auth.uid == userId &&
        exists(/databases/$(database)/documents/offers/$(offerId)) &&
        get(/databases/$(database)/documents/offers/$(offerId)).data.status == 'approved';
    }

    // PinBox (surprise-box discount sales, Kəşf et → Fürsətlər → PinBox)
    // — same moderation-lock shape as offers above: must start
    // 'pending', no forged review trail, admin panel is the only path
    // off 'pending'. `stockRemaining` is ALSO locked from direct client
    // writes (unlike ordinary offer fields) — PinBox Faza 7's checkout
    // decrements it atomically via a Cloud Function transaction, not a
    // client `update()`, so a race between two simultaneous buyers can
    // never oversell the same box.
    match /pinboxes/{pinboxId} {
      allow read: if request.auth != null;

      // Defense-in-depth (Düzəliş Prompt 8 / RT-2) — matches the
      // client's own existing `maxLength: 200` on this field
      // (create_pinbox_screen.dart) exactly.
      function descriptionSizeOk() {
        return !('description' in request.resource.data) || request.resource.data.description.size() <= 200;
      }

      // `get()`-based venue-ownership check (Düzəliş Prompt 2 / K-9) —
      // mirrors `venueEvents/{eventId}`'s own create rule below, the
      // proven pattern for the same problem. Without it, `ownerId ==
      // request.auth.uid` alone never verified the caller actually
      // owns `venueId` — the client (`firebase_pinbox_repository.dart`)
      // never independently checks this either, trusting rules
      // entirely, so this was a real gap: anyone could list a PinBox
      // against a venue they don't own.
      allow create: if request.auth != null &&
        request.auth.uid == request.resource.data.ownerId &&
        request.auth.uid == get(/databases/$(database)/documents/venues/$(request.resource.data.venueId)).data.ownerId &&
        isBusinessUser(request.auth.uid) &&
        isPinBoxCategory(request.resource.data.venueId) &&
        request.resource.data.status == 'pending' &&
        request.resource.data.stockRemaining == request.resource.data.stockTotal &&
        // P0 / H-5 — PinBox creation is one of the few listing flows
        // that still writes straight from the client (see this rule's
        // own comment), so the URL check has to live here rather than
        // in a callable. Edits go through `updatePinBox`, which applies
        // `assertOwnStorageUrl` server-side.
        (!('imageUrl' in request.resource.data) || request.resource.data.imageUrl == null ||
         isOwnStorageUrl(request.resource.data.imageUrl)) &&
        !('reviewNote' in request.resource.data) &&
        !('reviewedBy' in request.resource.data) &&
        !('reviewedAt' in request.resource.data) &&
        descriptionSizeOk();

      // `venueId` joins the update blocklist (Düzəliş Prompt 2 / K-9) —
      // no "move this listing to another venue" feature exists (confirmed
      // by grep: the only client `.update()` call never sends `venueId`),
      // so this is defense-in-depth, not a fix for a real client flow.
      // `title`/`description`/`originalPrice`/`pinboxPrice`/
      // `pickupWindowStart`/`pickupWindowEnd`/`imageUrl` join the lock
      // too (Düzəliş Prompt 6 / INFRA-5) — same reasoning as
      // `offers/{offerId}` right above: every real content edit now
      // goes through the `updatePinBox` Cloud Function (functions/src/
      // index.ts), which diffs old vs. new server-side and decides
      // whether the edit re-enters moderation. Before this, these
      // fields sat outside the blocklist — a modified client could
      // silently swap in different content on an already-`active`
      // PinBox and never call `resubmitPinBox`.
      allow update: if request.auth != null &&
        request.auth.uid == resource.data.ownerId &&
        request.resource.data.ownerId == resource.data.ownerId &&
        !request.resource.data.diff(resource.data).affectedKeys()
          // `category`/`lat`/`lng`/`position`/`address`/`country`/
          // `venueName`/`venuePhotoUrl`/`stockTotal` joined the lock
          // (P0, class-search finding C-c) — same omission as `offers`
          // above, same reasoning. `category` matters most here: the
          // create rule enforces `isPinBoxCategory(venueId)`, and
          // that check only ever runs at create, so an approved PinBox
          // could be moved into a category the feature is not allowed
          // in at all. `stockTotal` is the denominator every "N of M
          // left" display divides by, while `stockRemaining` was
          // already locked — leaving one half writable let the pair
          // disagree. `pinboxPrice`/`originalPrice` were already
          // locked and stay so (that is what keeps
          // `reservePinBoxOrder`'s charge honest).
          .hasAny(['status', 'reviewNote', 'reviewedBy', 'reviewedAt', 'stockRemaining', 'stockTotal', 'venueId', 'venueName', 'venuePhotoUrl', 'title', 'description', 'originalPrice', 'pinboxPrice', 'pickupWindowStart', 'pickupWindowEnd', 'imageUrl', 'category', 'lat', 'lng', 'position', 'address', 'country']) &&
        descriptionSizeOk();

      allow delete: if request.auth != null && request.auth.uid == resource.data.ownerId;
    }

    // A buyer's reservation of one PinBox. Deliberately NO client write
    // path at all (create OR update) — PinBox Faza 7's checkout must
    // decrement `pinboxes/{id}.stockRemaining` and create this order
    // atomically in the same transaction (a raw client create here
    // could race that decrement), and every status transition
    // (redemption in Faza 9, expiry) is likewise a Cloud Function using
    // the Admin SDK, which bypasses these rules entirely. Read is
    // buyer-only — the venue-side redemption flow verifies a scanned QR
    // token through a callable rather than reading this doc directly,
    // so it never needs broader read access.
    match /pinboxOrders/{orderId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.buyerId;
      allow write: if false;
    }

    // Monthly venue payout reconciliation (PinBox Faza 10) — entirely
    // Cloud-Function/admin-panel territory (Admin SDK bypasses these
    // rules); no mobile screen reads this per the PinBox spec, so
    // there's no client read path to grant.
    match /venuePayouts/{payoutId} {
      allow read, write: if false;
    }

    // Owner-published, auto-approved event — see `VenueEvent`'s doc
    // comment for why there's no `pending` moderation gate the way
    // venues/offers have one (the venue itself is already verified).
    // `status` only ever moves TO 'cancelled' from the client (the
    // owner, or nothing at all otherwise) — the upcoming→live→ended
    // lifecycle is exclusively `advanceVenueEventStatuses` (scheduled
    // Cloud Function, Admin SDK bypasses these rules).
    match /venueEvents/{eventId} {
      allow read: if request.auth != null;

      // Defense-in-depth (Düzəliş Prompt 8 / RT-2) — matches the
      // client's own existing `_kDescriptionMaxLength` (300,
      // create_event_screen.dart) exactly.
      function descriptionSizeOk() {
        return !('description' in request.resource.data) || request.resource.data.description.size() <= 300;
      }

      // P0 / H-5 — see `isOwnStorageUrl`. Events are `allow read: if
      // request.auth != null`, so a cover image renders for every
      // signed-in user who browses the venue; applied to create AND to
      // the content-edit branch of update below, since that branch can
      // swap `coverImageUrl` after the event is already live.
      // Two shapes, because this is used from both `create` (no
      // `resource` exists) and `update` (grandfathers an existing
      // value, same reasoning as `users.photoUrl` above).
      function coverImageUrlCreateOk() {
        return !('coverImageUrl' in request.resource.data) ||
          request.resource.data.coverImageUrl == null ||
          isOwnStorageUrl(request.resource.data.coverImageUrl);
      }
      function coverImageUrlUpdateOk() {
        return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['coverImageUrl']) ||
          request.resource.data.coverImageUrl == null ||
          isOwnStorageUrl(request.resource.data.coverImageUrl);
      }

      allow create: if request.auth != null &&
        request.auth.uid == get(/databases/$(database)/documents/venues/$(request.resource.data.venueId)).data.ownerId &&
        isEventCategory(request.resource.data.venueId) &&
        request.resource.data.status == 'upcoming' &&
        coverImageUrlCreateOk() &&
        descriptionSizeOk();

      // Two disjoint shapes: cancelling (status only, -> 'cancelled'),
      // or editing content (title/description/cover/time/category)
      // while the event hasn't ended/been cancelled yet — status
      // itself is never touched by an edit, only `cancelEvent` sets it.
      allow update: if request.auth != null &&
        request.auth.uid == get(/databases/$(database)/documents/venues/$(resource.data.venueId)).data.ownerId &&
        (
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']) &&
            request.resource.data.status == 'cancelled') ||
          (resource.data.status in ['upcoming', 'live'] &&
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['title', 'description', 'coverImageUrl', 'startAt', 'endAt', 'category']) &&
            coverImageUrlUpdateOk() &&
            descriptionSizeOk())
        );

      // Parity with `offers` and `pinboxes`: an owner may delete their
      // own listing. Events were the one product type with no delete at
      // all — only a `cancelled` status — so a venue could not remove
      // something posted by mistake, in any state.
      //
      // ANY status, including `live`. The owner owns the content; a
      // running event is theirs to pull. The client asks for
      // confirmation on a live one ("Bu tədbir hazırda davam edir")
      // rather than refusing, so the guard is against a mis-tap, not
      // against the intent.
      //
      // `onVenueEventDeleted` (functions/src/index.ts) removes the
      // `event_covers` object and its `_200x200` derivative — the
      // document going away is what triggers that, so this rule and
      // that trigger are one mechanism.
      allow delete: if request.auth != null &&
        request.auth.uid == get(/databases/$(database)/documents/venues/$(resource.data.venueId)).data.ownerId;
    }

    // Same write-only-from-clients shape as `reports` above, for
    // event-specific complaints — the admin panel's "Tədbir şikayətləri"
    // section reads/resolves these via the Admin SDK, which bypasses
    // these rules entirely.
    // `isActiveUser()` gate added to all three report-filing collections
    // below (Düzəliş Prompt 11 / Y-1, Variant B) — a banned account
    // filing retaliatory reports against whoever got them banned is its
    // own abuse vector, worse when combined with K-8's fixed reputation
    // -counter reasoning (a flood of reports against one target could
    // itself become a harassment tool).
    match /eventReports/{reportId} {
      // `reason` size cap (Düzəliş Prompt 8 / RT-2) — was unbounded on
      // both client and rules before; new limit on both sides now.
      allow create: if request.auth != null && request.auth.uid == request.resource.data.reportedBy &&
        isActiveUser(request.auth.uid) &&
        (!('reason' in request.resource.data) || request.resource.data.reason.size() <= 1000);
      allow read, update, delete: if false;
    }

    // Written exclusively by `computeBirthdayMatches` (scheduled Cloud
    // Function, Admin SDK — bypasses these rules entirely), same
    // "no client write path exists or should exist" reasoning as
    // venues/{venueId}/audienceHistory above.
    //
    // Read narrowed to the matched venue's own owner (Düzəliş Prompt 2 /
    // INFRA-11) — the bare `request.auth != null` this replaced let ANY
    // signed-in user `get()` or `list` any doc, relying entirely on a
    // client-side `hasBusinessAccess` flag (business-status account, not
    // "owns THIS venue") plus the doc id (`{date}_{venueId}`) being hard
    // to guess — neither is a real access-control boundary. The one
    // client read site (`fetchBirthdayMatch`, always a single already-
    // known-id `get()`) is unaffected by this: it already only fires for
    // the notification's own target venue. No `list` query exists
    // anywhere in the client, so that's closed outright rather than
    // narrowed.
    match /birthdayMatches/{matchId} {
      allow get: if request.auth != null &&
        request.auth.uid == get(/databases/$(database)/documents/venues/$(resource.data.venueId)).data.ownerId;
      allow list: if false;
      allow write: if false;
    }

    // P0 / H-1 (b) — the last query origin `findNearbyUsers` saw for
    // each uid, used by `assertPlausibleMovement` (functions/src/
    // index.ts) to reject a jump no real journey could make between two
    // calls. Kept OUT of `users/{uid}/private/data` on purpose: that
    // document is client-writable by design (it holds `lat`/`lng`
    // itself), so an attacker could reset their own last-known probe
    // between calls and neutralize the check. Server-only in both
    // directions — no client reads or writes this.
    // Daily-digest input: one document per listing published, holding
    // the venue's COORDINATES so `sendDailyOpportunityDigest` can match
    // it against each user's own radius.
    //
    // Closed to every client in both directions. Nothing in the app
    // reads it — the digest is a scheduled function on the Admin SDK —
    // and the contents are venue positions plus owner ids, which no
    // user has any reason to enumerate. Same shape and same reasoning
    // as `nearbyProbes` below.
    //
    // Cleanup is a native Firestore TTL policy on `expiresAt`
    // (docs/CONSOLE_MANUAL_STEPS.md), not a sweep function — see
    // `INTENT_RETENTION_DAYS` in functions/src/digest.ts.
    match /notificationIntents/{intentId} {
      allow read, write: if false;
    }

    match /nearbyProbes/{uid} {
      allow read, write: if false;
    }

    // Audit trail of account deletions (uid + timestamp only, no other
    // personal data) — written exclusively by the `deleteAccount`
    // Cloud Function (Admin SDK bypasses these rules entirely). No
    // client read or write path exists or should exist.
    match /accountDeletions/{entryId} {
      allow read, write: if false;
    }

    // 24h-expiring stories. Expiry itself is enforced client-side (the
    // watchMyActiveStories query filters `expiresAt > now`) — these
    // rules only gate who can read/write a given doc, not whether it's
    // "expired": an expired doc is still technically readable by
    // anyone its visibility already allowed, it just never surfaces in
    // the app's own queries. Only the creator can write/delete.
    //
    // Visibility is entirely the creator's `AccountPrivacy` now
    // ("Hesab gizliliyi") — a story doc no longer carries its own
    // `visibility` field. A pre-migration doc may still have one from
    // before this feature; it's simply never read.
    match /stories/{storyId} {
      // Fixed (post-launch QA) — stories are deleted outright once
      // expired (a scheduled cleanup, separate from the client-side
      // `expiresAt` filter mentioned above), so a stale deep link,
      // notification, or still-open viewer for an already-deleted story
      // used to hit the same `resource == null` evaluation error as a
      // real denial instead of a clean "this story is gone".
      allow read: if request.auth != null && (
        resource == null ||
        request.auth.uid == resource.data.creatorId ||
        get(/databases/$(database)/documents/users/$(resource.data.creatorId)).data.get('accountPrivacy', 'public') != 'private' ||
        isAcceptedFollower(request.auth.uid, resource.data.creatorId)
      );

      // `isActiveUser()` — see the `posts` collection's own create rule
      // for the full reasoning (P0 / C-3).
      allow create: if request.auth != null && request.auth.uid == request.resource.data.creatorId &&
        isActiveUser(request.auth.uid) &&
        // P0 / H-5 — see `isOwnStorageUrl`.
        (!('mediaUrl' in request.resource.data) || isOwnStorageUrl(request.resource.data.mediaUrl));

      allow update: if false;
      allow delete: if request.auth != null && request.auth.uid == resource.data.creatorId;

      // Who has viewed this story — only the story's own creator may
      // read the list (matches the in-app viewer-list UI); each viewer
      // may only write their OWN view doc (id == their uid), and only
      // once (no update/delete — a view can't be un-recorded).
      match /views/{viewerId} {
        allow read: if request.auth != null &&
          request.auth.uid == get(/databases/$(database)/documents/stories/$(storyId)).data.creatorId;
        allow create: if request.auth != null &&
          request.auth.uid == viewerId &&
          request.resource.data.viewerId == viewerId;
        allow update, delete: if false;
      }
    }

    // Profile feed posts. `likesCount`/`commentsCount` are ONLY ever
    // written by the deleteAccount-style Admin SDK (a Firestore-triggered
    // Cloud Function watching the likes/comments subcollections below) —
    // the owner may only ever update the `caption` field client-side,
    // matching the "no client-side manual counting" requirement.
    match /posts/{postId} {
      // The direct `resource.data.userId == request.auth.uid` branch
      // is NOT redundant with `canReadPost`'s own owner check — it's
      // what makes `watchUserPosts`'s LIST query (`where('userId', '==',
      // myUid)`) work at all. Firestore only allows a list/collection
      // query when it can statically prove every possible result
      // satisfies the rule; a `get()`-based function like `canReadPost`
      // can't be proven that way (Firestore has to actually run it per
      // document, which it won't do speculatively for a query), so a
      // rule of *only* `canReadPost(postId)` makes Cloud Firestore
      // reject the owner's own "my posts" query outright with
      // `permission-denied` — silently, from this app's perspective,
      // since `userPostsProvider`'s stream error was never surfaced
      // (see profile_tab.dart's own fix for that). A direct
      // `resource.data.field == request.auth.uid` comparison, however,
      // IS something Firestore can match against a `where` clause on
      // that same field, so it recognizes this exact query shape as
      // provably safe.
      //
      // KNOWN REMAINING GAP: `userPostsProvider`/`watchUserPosts` is
      // also how `user_profile_screen.dart` lists someone ELSE's
      // posts (`where('userId', '==', otherUid)`) — that query still
      // can't be proven safe (the privacy/follower check needs a
      // `get()` Firestore won't evaluate speculatively for a `list`),
      // so it's rejected outright and that screen's post grid is
      // currently broken too, same root cause, not yet fixed. Fixing
      // it properly needs the list moved server-side (Cloud Function,
      // Admin SDK) rather than another rules-only patch — rules
      // fundamentally can't make a privacy-conditional `list` query
      // provable this way.
      // `resource.data.authorIsPublic == true` is what makes the
      // discover/search video grid's cross-author LIST query provable
      // — same reasoning as the `userId == request.auth.uid` branch
      // above: Firestore can match a flat field compare against a
      // query's `where` clause, but never a `get()`-based check like
      // `canReadPost`. `authorIsPublic` is a denormalized, server-only
      // copy of the author's `accountPrivacy` (set/kept in sync by
      // `onPostCreated`/`onUserUpdated` in Cloud Functions) — clients
      // can never write it themselves (see `allow update` below).
      // Fixed (post-launch QA) — `resource == null ||` added for the
      // same reason as every other single-`get()` fix in this file (a
      // deleted post, or a stale notification/deep-link to one, used to
      // read as permission-denied instead of not-found). Deliberately
      // placed as the FIRST disjunct, before the two flat-field
      // comparisons the comment above depends on for LIST-query
      // provability — `resource` is never null for a document a query
      // actually returns, so this is a no-op for `watchUserPosts`'s two
      // list queries and doesn't disturb their provability; verified
      // empirically by this file's own rules-unit-test suite (a list
      // query that stopped being provable fails outright, it doesn't
      // silently return fewer results).
      allow read: if request.auth != null &&
        (resource == null || resource.data.userId == request.auth.uid || resource.data.authorIsPublic == true || canReadPost(postId));
      // `isActiveUser()` (P0 / C-3) — was deliberately left off here per
      // Düzəliş Prompt 11's Variant B scope ("lower abuse-per-write than
      // messaging/calls/reports"), and that reasoning still holds for
      // BANNED accounts. What it missed is the other class this same
      // check excludes: an account with NO `users/{uid}` document at
      // all. `completeOnboarding` (Cloud Function) is the only thing
      // that creates that document, and it is where the 18+ minimum-age
      // gate runs — so before this, an under-18 whose onboarding call
      // was REJECTED could still publish posts for the rest of that
      // session (the client navigated to HomeScreen regardless; see
      // `AuthController.completeOnboarding`'s own doc comment for that
      // half of the fix). Public, permanent, user-generated content by
      // an account that never cleared the age gate is a child-safety
      // and store-policy problem, not a moderation-cost trade-off,
      // which is why this one is no longer deferred. Same reasoning for
      // `stories` and post `comments` below; `supportMessages` is
      // deliberately NOT gated — a user stuck in exactly this state
      // must still be able to reach support.
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId &&
        isActiveUser(request.auth.uid) &&
        // P0 / H-5 — see `isOwnStorageUrl`. `posts` are listable
        // cross-author through `authorIsPublic`, so a post's media
        // renders on strangers' devices in the discover grid.
        (!('mediaUrl' in request.resource.data) || isOwnStorageUrl(request.resource.data.mediaUrl)) &&
        (!('thumbnailUrl' in request.resource.data) || isOwnStorageUrl(request.resource.data.thumbnailUrl));
      allow update: if request.auth != null
        && request.auth.uid == resource.data.userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['caption']);
      allow delete: if request.auth != null && request.auth.uid == resource.data.userId;

      // One doc per liker, id == their own uid — that shape is both
      // the "did I like this" check and the trigger's fan-in source.
      match /likes/{userId} {
        allow read: if request.auth != null && canReadPost(postId);
        allow create, delete: if request.auth != null && request.auth.uid == userId;
        allow update: if false;
      }

      match /comments/{commentId} {
        allow read: if request.auth != null && canReadPost(postId);
        // `isActiveUser()` — see the `posts` collection's own create
        // rule for the full reasoning (P0 / C-3).
        allow create: if request.auth != null && request.auth.uid == request.resource.data.userId &&
          isActiveUser(request.auth.uid);

        // Author may only ever change the comment's own text (mirrors
        // the post caption rule above) — likesCount is server-only.
        allow update: if request.auth != null
          && request.auth.uid == resource.data.userId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text']);

        // Either the comment's own author OR the post's owner may
        // delete it — Instagram-style "remove comments on my post".
        allow delete: if request.auth != null && (
          request.auth.uid == resource.data.userId ||
          request.auth.uid == get(/databases/$(database)/documents/posts/$(postId)).data.userId
        );

        match /likes/{userId} {
          allow read: if request.auth != null;
          allow create, delete: if request.auth != null && request.auth.uid == userId;
          allow update: if false;
        }
      }
    }

    // Write-only from clients — reviewed by moderators outside the app.
    // `isActiveUser()` gate — see `eventReports` above for why.
    match /reports/{reportId} {
      // `reason` size cap (Düzəliş Prompt 8 / RT-2) — see `eventReports` above.
      allow create: if request.auth != null && request.auth.uid == request.resource.data.reporterId &&
        isActiveUser(request.auth.uid) &&
        (!('reason' in request.resource.data) || request.resource.data.reason.size() <= 1000);
      allow read, update, delete: if false;
    }

    // "Şikayət et" on a review — same write-only-by-reporter shape as
    // `reports`/`eventReports` above. Resolved from the admin panel's
    // "Review Reports" page (`onReviewReportCreated` relays it there).
    // `isActiveUser()` gate — see `eventReports` above for why.
    match /reviewReports/{reportId} {
      // `reason` size cap (Düzəliş Prompt 8 / RT-2) — see `eventReports` above.
      allow create: if request.auth != null && request.auth.uid == request.resource.data.reporterId &&
        isActiveUser(request.auth.uid) &&
        (!('reason' in request.resource.data) || request.resource.data.reason.size() <= 1000);
      allow read, update, delete: if false;
    }

    // Moderator/admin audit trail ("kim nə edib") — written by the
    // Next.js admin panel's Server Actions via the Admin SDK only,
    // which bypasses these rules entirely; this block exists purely to
    // make the deny explicit and keep the pattern consistent with
    // `reports` above. No client (mobile app or otherwise) ever reads
    // or writes this collection.
    match /moderationLogs/{logId} {
      allow read, write: if false;
    }

    // Admin/moderator roster — a denormalized index the admin panel's
    // "Admin idarəetməsi" screen lists from, kept in sync with Firebase
    // Auth custom claims by its own Server Actions (Admin SDK, bypasses
    // this rule entirely). This collection is NEVER the source of
    // truth for authorization — the custom claim on the session cookie
    // is — it exists purely because there's no way to query "all Auth
    // users with a given custom claim" directly, and enumerating every
    // app user to find the handful of admins doesn't scale. No client
    // (mobile app or otherwise) ever reads or writes it.
    match /admins/{uid} {
      allow read, write: if false;
    }

    // PeakPin VIP ekranının funksiya siyahısı — marketinq mətni, admin
    // tərəfindən Firebase console-dan idarə olunur.
    match /vipFeatures/{featureId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Yardım ekranının "Problem bildir" / "Təklif göndər" formları.
    // Write-only from the client — only readable via the Firebase
    // console / a future admin tool, same shape as /reports above.
    match /supportMessages/{messageId} {
      // `message` size cap (Düzəliş Prompt 8 / RT-2) — was unbounded on
      // both client and rules before; new limit on both sides now.
      allow create: if request.auth != null && request.auth.uid == request.resource.data.uid &&
        (!('message' in request.resource.data) || request.resource.data.message.size() <= 2000);
      allow read, update, delete: if false;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }

    // ACCEPTED, DOCUMENTED RISK (Düzəliş Prompt 11 / Y-1) — the
    // `isActiveUser()` gate above closes the highest-harm write paths
    // for a banned/deleted account (chat messages, calls, the three
    // report collections), but is deliberately NOT applied everywhere:
    // (1) no `allow read` rule anywhere in this file checks
    // `isActiveUser()` — a banned/deleted account's still-cryptographically
    // -valid ID token (up to ~1h, Firebase's own natural expiry) can
    // keep READING anything its existing rules already permitted
    // (profiles, chats it's a participant of, venues, etc.);
    // (2) `pinboxes`, `venueEvents`, and `supportMessages` create are
    // also not gated this way (Variant B scope — lower abuse-per-write
    // than messaging/calls/reports). Both are accepted for now, not
    // oversights — extending `isActiveUser()` to more `allow` rules is a
    // small, mechanical follow-up whenever it's prioritized.
    //
    // `posts`, `stories` and post `comments` were REMOVED from that
    // deferred list (P0 / C-3): the gate there is no longer about
    // ban-enforcement cost but about accounts that never cleared the
    // 18+ check in `completeOnboarding` at all — `isActiveUser()`
    // requires `users/{uid}` to EXIST, and that document is created
    // only by that function, only after the age gate passes. See those
    // rules' own comments. `supportMessages` stays ungated on purpose,
    // so an account stuck in exactly that state can still reach support.
  }
}
