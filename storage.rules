rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Matches the actual upload path (`profile_photos/{userId}/profile.jpg`,
    // see FirebaseStorageRepository) — the previous `{userId}.jpg` pattern
    // was both invalid Storage Rules syntax and didn't match that path.
    match /profile_photos/{userId}/{fileName} {
      // Anyone signed in can view profile photos (needed to show
      // other users' photos on the map / marker cards).
      allow read: if request.auth != null;

      // A user can only upload/replace/delete their OWN photo,
      // and only images up to 5MB.
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Chat image messages — only the two people in the chat (its id
    // is "${uidA}_${uidB}") can view it. `{senderId}` joined the path
    // (Düzəliş Prompt 3 / RT-8) — the old flat `{chatId}/{fileName}`
    // shape had no sender identity anywhere in it, so `allow delete`
    // could only check chat-participant membership, meaning EITHER
    // participant could delete the other's uploaded file directly via
    // the Storage SDK (bypassing the Firestore message doc's own
    // sender-only delete rule entirely, since that only governs the
    // Firestore doc, not the underlying Storage object). `create` now
    // requires the path's `{senderId}` segment to match the caller,
    // mirroring `firestore.rules`' own `senderId == request.auth.uid`
    // check on the message doc — the two are now symmetric.
    match /chat_photos/{chatId}/{senderId}/{fileName} {
      allow read: if request.auth != null && chatId.split('_').hasAny([request.auth.uid]);

      allow create: if request.auth != null
                   && chatId.split('_').hasAny([request.auth.uid])
                   && request.auth.uid == senderId
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');

      // Sender-only now (Düzəliş Prompt 3 / RT-8) — was participant-only,
      // letting a recipient delete the sender's own uploaded file.
      allow delete: if request.auth != null && request.auth.uid == senderId;
    }

    // Chat video messages — same shape/reasoning as chat_photos above
    // (Düzəliş Prompt 3 / RT-8); capped at 50MB to match SendVideoMessageUseCase.
    match /chat_videos/{chatId}/{senderId}/{fileName} {
      allow read: if request.auth != null && chatId.split('_').hasAny([request.auth.uid]);

      allow create: if request.auth != null
                   && chatId.split('_').hasAny([request.auth.uid])
                   && request.auth.uid == senderId
                   && request.resource.size < 50 * 1024 * 1024
                   && request.resource.contentType.matches('video/.*');

      allow delete: if request.auth != null && request.auth.uid == senderId;
    }

    // Chat voice messages — same shape/reasoning as chat_photos above
    // (Düzəliş Prompt 3 / RT-8); capped at 10MB to match SendAudioMessageUseCase.
    match /chat_audio/{chatId}/{senderId}/{fileName} {
      allow read: if request.auth != null && chatId.split('_').hasAny([request.auth.uid]);

      allow create: if request.auth != null
                   && chatId.split('_').hasAny([request.auth.uid])
                   && request.auth.uid == senderId
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('audio/.*');

      allow delete: if request.auth != null && request.auth.uid == senderId;
    }

    // Event cover photos — path is now `event_covers/{ownerUid}/{eventId}.jpg`
    // (Düzəliş Prompt 3 / K-6, was flat `{eventId}.jpg`). The old
    // "unguessable Firestore auto-id" reasoning this comment used to
    // give was WRONG — `eventId` is a plain `collection.doc().id`,
    // `venueEvents/{eventId}` is `allow read: if request.auth != null`
    // in firestore.rules, and the client's own open discovery queries
    // hand every signed-in user a live list of these ids during normal
    // app use. Without an owner check, any signed-in user could
    // overwrite/replace any event's cover photo. Reads stay open (event
    // discovery is public); only the owner may write.
    match /event_covers/{ownerUid}/{fileName} {
      allow read: if request.auth != null;

      allow write: if request.auth != null
                   && request.auth.uid == ownerUid
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Venue photos — path is now `venue_photos/{ownerUid}/{venueId}.jpg`
    // (Düzəliş Prompt 3 / K-6, was flat `{venueId}.jpg`) — see
    // `event_covers` above for why the old "unguessable id" reasoning
    // was wrong and what this closes.
    match /venue_photos/{ownerUid}/{fileName} {
      allow read: if request.auth != null;

      allow write: if request.auth != null
                   && request.auth.uid == ownerUid
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Offer photos — path is now `offer_photos/{ownerUid}/{offerId}.jpg`
    // (Düzəliş Prompt 3 / K-6, was flat `{offerId}.jpg`) — see
    // `event_covers` above for why the old "unguessable id" reasoning
    // was wrong and what this closes.
    match /offer_photos/{ownerUid}/{fileName} {
      allow read: if request.auth != null;

      allow write: if request.auth != null
                   && request.auth.uid == ownerUid
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // PinBox photos — path is now `pinbox_photos/{ownerUid}/{pinboxId}.jpg`
    // (Düzəliş Prompt 3 / K-6, was flat `{pinboxId}.jpg`) — see
    // `event_covers` above for why the old "unguessable id" reasoning
    // was wrong and what this closes.
    match /pinbox_photos/{ownerUid}/{fileName} {
      allow read: if request.auth != null;

      allow write: if request.auth != null
                   && request.auth.uid == ownerUid
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // TRANSITION-ONLY (Düzəliş Prompt 3 / K-6) — the 46 files still
    // sitting at the OLD flat paths (`venue_photos/{id}.jpg` etc.,
    // pre-migration) keep working for reads until the approved-but-not
    // -yet-run migration script moves them to the new `{ownerUid}/...`
    // paths above and updates each Firestore doc's stored URL. `write`
    // is deliberately absent here (falls through to the default-deny
    // below) — no NEW upload should ever land on a flat path again,
    // only the new owner-uid rules above accept writes. Delete this
    // whole block once the migration has actually run and these old
    // objects are gone.
    match /venue_photos/{fileName} {
      allow read: if request.auth != null;
    }
    match /offer_photos/{fileName} {
      allow read: if request.auth != null;
    }
    match /pinbox_photos/{fileName} {
      allow read: if request.auth != null;
    }
    match /event_covers/{fileName} {
      allow read: if request.auth != null;
    }

    // 24h stories — image or video, owner-only upload. Read is open to
    // any signed-in user (same precedent as every other path above);
    // Firestore's own `stories/{storyId}` visibility rule is the real
    // gate on who ever learns this URL exists in the first place.
    match /stories/{userId}/{fileName} {
      allow read: if request.auth != null;

      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && (
                     (request.resource.contentType.matches('image/.*') && request.resource.size < 5 * 1024 * 1024) ||
                     (request.resource.contentType.matches('video/.*') && request.resource.size < 50 * 1024 * 1024)
                   );
    }

    // Profile feed post media — image or video, owner-only upload, same
    // shape as /stories/{userId} above.
    match /posts/{userId}/{fileName} {
      allow read: if request.auth != null;

      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && (
                     (request.resource.contentType.matches('image/.*') && request.resource.size < 5 * 1024 * 1024) ||
                     (request.resource.contentType.matches('video/.*') && request.resource.size < 50 * 1024 * 1024)
                   );
    }

    // "Kimlik doğrulama" (ID front/back + selfie-with-ID) — deliberately
    // NO read rule at all, unlike every other path above (which all
    // allow any signed-in user to read). Falls through to the
    // `{allPaths=**}` default-deny below, so nobody — not even the
    // uploader themselves — can read these via the client SDK; the
    // admin panel reads them exclusively through the Admin SDK (which
    // bypasses these rules entirely) and hands out short-lived signed
    // URLs server-side. {requestId} (not just {userId}) scopes each
    // submission's files separately, so a rejected-then-resubmitted
    // user's old evidence isn't silently overwritten, and the Faza 4
    // retention sweep can delete one request's files without touching
    // a later one.
    match /identity_verifications/{userId}/{requestId}/{fileName} {
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
