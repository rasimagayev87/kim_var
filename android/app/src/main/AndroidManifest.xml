<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- No ad SDK is used — this permission is pulled in transitively by a
         Google Play Services dependency, not declared by this app. Removed
         explicitly so the Play Console "advertising ID" declaration can
         honestly answer No instead of merging it in unused. -->
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" tools:node="remove"/>
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-permission android:name="android.permission.CAMERA"/>
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS"/>
    <!-- Required by `in_app_purchase` for Google Play Billing (VIP
         subscriptions — see lib/features/premium/). -->
    <uses-permission android:name="com.android.vending.BILLING"/>
    <uses-feature android:name="android.hardware.camera" android:required="false"/>
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false"/>
    <application
        android:label="PeakPin"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:enableOnBackInvokedCallback="true">
        <!-- TODO: replace with your own key from Google Cloud Console
             (enable "Maps SDK for Android" + billing). Without a valid
             key the map will show a grey grid instead of real map tiles. -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="AIzaSyD0qRdS8RnMv1QxdApvEBjZQwmh55xPf_8"/>
        <!-- Branch (deferred deep linking). From the Branch dashboard:
             Settings (ACCOUNT section) -> Profile -> "Branch Key and
             Secret" -> Branch Key. Do NOT put the Branch Secret here
             or anywhere client-side — it's server-only. -->
        <meta-data android:name="io.branch.sdk.BranchKey" android:value="key_live_gvCTsTZgmBWo3ILjha8wuacaqFfXTcrJ"/>
        <!-- Required by the `pay` package for Google Pay (Boost/subscription/
             offer-fee checkout, see lib/core/payments/) — declares the app as
             a Google Pay API user. Still gated on Epoint approving the
             merchant account before it can actually charge anything (see
             assets/payments/google_pay_config.json's own comment). -->
        <meta-data android:name="com.google.android.gms.wallet.api.enabled" android:value="true"/>
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- App Links for post share URLs (https://peakpin.app/p/{id},
                 Instagram's own /p/ convention) and profile share URLs
                 (https://peakpin.app/u/{username}, TikTok's own /u/
                 convention). assetlinks.json is now live at
                 peakpin.app/.well-known/assetlinks.json (see
                 peakpin-landing's public/.well-known/ — its
                 sha256_cert_fingerprints entry must be regenerated from
                 android/keystore/peakpin-release.jks any time that
                 keystore changes), so autoVerify can actually take users
                 straight to the app instead of a disambiguation sheet
                 once this build ships. See deep_link_handler.dart for
                 the Dart-side handler. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="https" android:host="peakpin.app" android:pathPrefix="/p"/>
                <data android:scheme="https" android:host="peakpin.app" android:pathPrefix="/u"/>
            </intent-filter>
            <!-- Custom URL scheme fallback for Firebase Email Link
                 sign-in — see deep_link_handler.dart and
                 peakpin-landing's /auth-email-link page. Used instead
                 of relying solely on the https App Link above because
                 the final hop in that flow (peakpin.app/auth-email-link)
                 needs a way back into the app that doesn't depend on
                 domain-verification timing. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="peakpin"/>
            </intent-filter>
        </activity>
        <!-- Required by image_cropper (venue photo crop step) — the
             plugin doesn't declare this itself, the consuming app
             must (see the package's own example app manifest). -->
        <activity
            android:name="com.yalantis.ucrop.UCropActivity"
            android:screenOrientation="portrait"
            android:theme="@style/Ucrop.CropTheme"/>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
