# Resize Images extension (firebase/storage-resize-images) — configured
# per the "PeakPin — Firebase Extensions: Resize Images inteqrasiyası"
# task, Faza 1. Every param here was chosen deliberately:
#
# - Original images are KEPT (DELETE_ORIGINAL_FILE=false) — detail/
#   full-screen views (VenueProfileScreen, OfferDetailsScreen, etc.)
#   still need the original, only grid/list views switch to the
#   resized thumbnail.
# - Resized images are NOT public (MAKE_PUBLIC=false) — several of the
#   included paths (chat_photos in particular) are access-restricted
#   by storage.rules to specific users (chat participants only); a
#   public thumbnail URL would bypass that entirely. Resized images
#   stay behind the same signed-download-URL scheme as originals.
# - identity_verifications/ is EXCLUDED — those images must stay
#   original quality for admin document/liveness review, and that
#   path already has no `read` rule at all (admin-SDK-only); resizing
#   it would be both unwanted and a needless extra write into a
#   deliberately locked-down path.
# - Content filtering is OFF — this app already has its own
#   admin-moderation pipeline for venues/offers/etc.; enabling
#   AI-based content filtering here would add cost/latency and risk
#   false-positive blocks on a path that was never asked to do that.

IMG_BUCKET=kim-var-73ce9.firebasestorage.app
IMG_SIZES=200x200
DELETE_ORIGINAL_FILE=false
MAKE_PUBLIC=false
RESIZED_IMAGES_PATH=
INCLUDE_PATH_LIST=/profile_photos,/venue_photos,/offer_photos,/pinbox_photos,/stories,/posts,/event_covers,/chat_photos
EXCLUDE_PATH_LIST=/identity_verifications
FAILED_IMAGES_PATH=
CACHE_CONTROL_HEADER=
IMAGE_TYPE=false
OUTPUT_OPTIONS=
SHARP_OPTIONS=
IS_ANIMATED=true
FUNCTION_MEMORY=1024
# false (not the extension's own default of true) — deliberately, so
# the resized image REUSES the original's download token instead of
# getting a fresh one. Firebase Storage's public HTTP gateway (what
# `Image.network()` actually hits, with no Firebase Auth session of
# its own) authorizes a download purely by that token, so a shared
# token is what lets the app derive a resized image's URL client-side
# by simple string substitution (same base URL/token, filename gets
# the `_200x200` suffix) instead of needing a second async
# `getDownloadURL()` round-trip — or a whole extra Cloud Function
# syncing resized-image URLs back into Firestore — for every single
# image the app shows. No security cost: the resized image is the
# exact same content at a smaller size, so anyone who could already
# read one could always derive the other.
REGENERATE_TOKEN=false
CONTENT_FILTER_LEVEL=OFF
CUSTOM_FILTER_PROMPT=
PLACEHOLDER_IMAGE_PATH=
